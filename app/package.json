{
  "name": "mini-client",
  "version": "1.0.0",
  "description": "Mini Client",
  "main": "main.js",
  "author": "Mini Client",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.miniclient.app",
    "productName": "Mini Client",
    "files": [
      "main.js",
      "preload.js",
      "auth.js",
      "ui/**/*",
      "icon.ico"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "MiniClient-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "compression": "normal",
    "asar": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/xomaim/miniclient/releases/download/app-latest"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}