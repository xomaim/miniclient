<!DOCTYPE html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="ie=edge">
<title>Mini Client</title>
<hta:application id="app" applicationname="MiniClient14" border="none" caption="no"
  scroll="no" singleinstance="no" sysmenu="no" minimizebutton="no" maximizebutton="no" showintaskbar="yes" />
<style>
  * { box-sizing: border-box; }
  html, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; }
  body { font-family:"Segoe UI", Arial, sans-serif; font-size:14px; color:#ebebeb; background:#1d1d20; }

  /* ---------- scenery layer ---------- */
  #sky { position:absolute; left:0; top:0; right:0; bottom:0; z-index:0; overflow:hidden;
         background:#232327;
         filter:progid:DXImageTransform.Microsoft.gradient(startColorstr='#FF17171a', endColorstr='#FF29292d', GradientType=0);
         -ms-filter:"progid:DXImageTransform.Microsoft.gradient(startColorstr='#FF17171a', endColorstr='#FF29292d', GradientType=0)"; }
  #glow { position:absolute; left:0; right:0; bottom:0; height:300px; z-index:0; }

  /* ---------- UI layer ---------- */
  #ui { position:absolute; left:0; top:0; right:0; bottom:0; z-index:2; }

  html { background:#1d1d20; }
  body { border:1px solid #29292d; }

  /* ---------- custom title bar (replaces the white Windows one) ---------- */
  #titlebar { position:absolute; left:0; right:0; top:0; height:34px; z-index:30; background:rgba(21,21,24,0.55);
              text-align:center; line-height:34px; color:#ebebeb; font-size:13px; font-weight:600; letter-spacing:0.6px;
              cursor:default; -ms-user-select:none; user-select:none; }
  #tbclose { position:absolute; right:0; top:0; width:46px; height:34px; line-height:32px; color:#ebebeb; font-size:20px; cursor:pointer; }
  #tbclose:hover { background:#ebebeb; color:#ffffff; }

  /* ---------- left sidebar ---------- */
  #side { position:absolute; left:0; top:34px; bottom:0; width:84px; background:rgba(21,21,24,0.62); border-right:1px solid rgba(255,255,255,0.07); z-index:4; }
  #slogo { height:84px; text-align:center; padding-top:18px; }
  #slogo img { width:46px; height:46px; -ms-interpolation-mode:bicubic; }
  .sn { position:relative; height:58px; margin:1px 8px; border-radius:12px; text-align:center; color:#ebebeb; cursor:pointer; padding-top:7px; }
  .sn svg { width:24px; height:24px; display:block; margin:0 auto 5px auto; stroke:#ebebeb; fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .sn span { font-size:11px; font-weight:600; letter-spacing:0.2px; }
  .sn:hover { background:rgba(255,255,255,0.07); color:#ffffff; }
  .sn:hover svg { stroke:#ffffff; }
  .sn.on { background:rgba(235,235,235,0.22); color:#ffffff; }
  .sn.on svg { stroke:#ebebeb; }
  .sn.on:before { content:""; position:absolute; left:-8px; top:16px; width:4px; height:34px; border-radius:2px; background:#ebebeb; }
  #sver { position:absolute; bottom:12px; left:0; right:0; text-align:center; font-size:10px; color:#9894a5; }

  .page { display:none; position:absolute; left:84px; right:0; top:34px; bottom:0; }


  /* ---------- home page ---------- */
  #hhead { position:absolute; left:34px; right:34px; top:22px; height:56px; }
  #hero { position:absolute; left:34px; right:34px; top:92px; height:230px; border-radius:16px; overflow:hidden; border:1px solid rgba(255,255,255,0.12); background-color:#323232; }
  #herofade { position:absolute; left:0; top:0; right:0; bottom:0; background:rgba(24,24,24,0.52); }
  #herotext { position:absolute; left:30px; top:26px; width:560px; }
  #herotag { margin-bottom:12px; }
  #herotitle { font-size:40px; font-weight:700; color:#ffffff; letter-spacing:-1px; line-height:44px; }
  #herodesc { font-size:13px; color:#ebebeb; margin:8px 0 20px 0; width:440px; line-height:1.5; }
  #herobtn { height:46px; padding:0 30px; font-size:14px; font-weight:700; letter-spacing:1px; background:#ebebeb; color:#ffffff; margin-right:10px; }
  #herobtn:hover { background:#ebebeb; }
  #herobtn[disabled] { background:rgba(255,255,255,0.10); color:#9894a5; cursor:default; }
  #heroalt { height:46px; padding:0 22px; font-size:14px; }
  #svlist .svrow { display:block; position:relative; height:56px; padding:10px 14px; margin-bottom:8px; }
  .svico { float:left; margin-right:14px; border-radius:6px; background:#161616; }
  .svtxt b { display:block; font-size:15px; margin-top:4px; color:#ffffff; } .svtxt span { color:#ebebeb; font-size:12px; }
  #svlist .btn { float:right; margin:10px 0 0 8px; }
  #svlist #svlist { }
  #hnewshead { position:absolute; left:34px; top:340px; font-size:11px; font-weight:700; letter-spacing:1.4px; color:#ebebeb; }
  #hnews { position:absolute; left:34px; right:34px; top:362px; height:150px; }
  .ncard { float:left; width:228px; height:124px; margin-right:14px; border-radius:14px; padding:16px 18px; background:rgba(35,35,35,0.80); border:1px solid rgba(255,255,255,0.10); overflow:hidden; }
  .ncard:hover { border-color:rgba(255,255,255,0.28); }
  .ncard .vt { margin-bottom:8px; }
  .ntitle { font-size:16px; font-weight:700; color:#ffffff; margin-bottom:6px; }
  .ntext { font-size:12px; line-height:1.5; color:#ebebeb; }
  #promo { position:absolute; left:34px; right:34px; top:540px; height:62px; border-radius:14px; background:rgba(35,35,35,0.86); border:1px solid rgba(255,255,255,0.12); padding:0 18px; line-height:62px; }
  #promo > * { vertical-align:middle; }
  #promobadge { margin:0 14px 0 0; line-height:16px; padding:3px 12px; background:rgba(235,235,235,0.30); color:#ebebeb; }
  #promotext { display:inline-block; width:560px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; line-height:20px; }
  #promotext b { color:#ffffff; margin-right:10px; }
  #promodesc { color:#ebebeb; font-size:12px; }
  #promobtn { float:right; margin:14px 0 0 0; }

  /* ---------- play page ---------- */
  #phead { position:absolute; left:34px; right:34px; top:22px; height:56px; }
  #ptitle { font-size:30px; font-weight:700; color:#ffffff; letter-spacing:-0.8px; line-height:32px; }
  #ptitle span { color:#ebebeb; }
  #psub { font-size:12px; color:#ebebeb; margin-top:3px; }
  #pright { position:absolute; right:0; top:2px; white-space:nowrap; }
  #pright > * { display:inline-block; vertical-align:middle; }
  #chip { height:44px; padding:4px 16px 4px 5px; border-radius:22px; background:rgba(21,21,24,0.7); border:1px solid rgba(255,255,255,0.10); margin-left:8px; }
  #chip #avatar { float:left; width:34px; height:34px; border-radius:17px; margin-right:10px; font-size:16px; line-height:34px; overflow:hidden; }
  #chip #avatar img { width:34px; height:34px; }
  #chip #acctText { overflow:hidden; padding-top:0; }
  #chip #who { font-size:13px; line-height:18px; }
  #chip #email { font-size:10px; margin-top:0; height:13px; line-height:13px; max-width:150px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
  .pill { display:inline-block; padding:5px 12px; border-radius:14px; background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.08); font-size:12px; color:#ebebeb; }
  #vhead { position:absolute; left:34px; top:96px; font-size:11px; font-weight:700; letter-spacing:1.4px; color:#ebebeb; }
  #vgrid { position:absolute; left:34px; top:120px; width:540px; }
  .vc { float:left; width:250px; height:142px; margin:0 14px 14px 0; border-radius:14px; border:2px solid rgba(255,255,255,0.10); cursor:pointer; position:relative; overflow:hidden; background-color:#29292d; }
  .vc:hover { border-color:rgba(255,255,255,0.35); }
  .vc.on { border-color:#ebebeb; }
  .vc .vtag { position:absolute; left:10px; top:10px; padding:3px 10px; border-radius:11px; font-size:11px; font-weight:600; background:rgba(21,21,24,0.72); color:#ebebeb; }
  .vc .vband { position:absolute; left:0; right:0; bottom:0; height:50px; background:rgba(21,21,24,0.58); }
  .vc .vname { position:absolute; left:14px; bottom:8px; font-size:22px; font-weight:700; color:#ffffff; letter-spacing:-0.6px; }
  .vc .vsub { position:absolute; right:14px; bottom:16px; font-size:11px; color:#ebebeb; }
  #vpanel { position:absolute; right:34px; top:96px; width:300px; padding:0; overflow:hidden; }
  #vart { height:150px; background-color:#29292d; position:relative; }
  #vskin { position:absolute; right:16px; bottom:0; height:146px; }
  #vbody { padding:16px 20px 20px 20px; }
  #vtitle { font-size:22px; font-weight:700; color:#ffffff; letter-spacing:-0.4px; }
  #vtags { margin:8px 0 10px 0; }
  .vt { display:inline-block; margin:0 6px 6px 0; padding:2px 10px; border-radius:10px; font-size:11px; background:rgba(255,255,255,0.09); color:#ebebeb; }
  .vt.hot { background:rgba(235,235,235,0.28); color:#ebebeb; }
  #vdesc { font-size:12px; line-height:1.55; color:#ebebeb; min-height:56px; }
  .vrow { overflow:hidden; font-size:12px; color:#ebebeb; padding:9px 0; border-top:1px solid rgba(255,255,255,0.07); }
  .vrow b { float:right; color:#ffffff; font-weight:600; }
  #vpanel #badge { float:right; margin:0; }
  #vsel { margin-top:6px; }
  #vsel select { height:34px; }
  #playbtn { width:100%; height:50px; margin-top:12px; font-size:15px; font-weight:700; letter-spacing:1.2px; background:#ebebeb; color:#ffffff; }
  #playbtn:hover { background:#ebebeb; }
  #playbtn[disabled] { background:rgba(255,255,255,0.10); color:#9894a5; cursor:default; }
  .row { margin-bottom:16px; }

  button { font-family:"Segoe UI", Arial, sans-serif; cursor:pointer; border:0; border-radius:8px; }
  .btn { height:50px; padding:0 24px; font-size:15px; background:rgba(255,255,255,0.09); color:#ebebeb; }
  .btn:hover { background:rgba(255,255,255,0.16); }
  .btn.small { height:34px; padding:0 16px; font-size:13px; }
  .meta { font-size:12px; color:#ebebeb; }

  /* ---------- cards ---------- */
  .card { background:rgba(30,30,33,0.88); border:1px solid rgba(255,255,255,0.09); border-radius:16px; padding:22px 24px; }
  .label { font-size:12px; color:#ebebeb; margin-bottom:14px; }

  #avatar { float:left; width:56px; height:56px; border-radius:28px; background:#ebebeb; color:#ffffff;
            font-size:26px; font-weight:700; text-align:center; line-height:56px; margin-right:16px; }
  #acctText { overflow:hidden; padding-top:3px; }
  #who { font-size:22px; font-weight:700; color:#ffffff; }
  #email { color:#ebebeb; font-size:12px; margin-top:2px; height:16px; }
  #badge { display:inline-block; margin-top:16px; padding:3px 12px; border-radius:12px; font-size:12px;
           background:rgba(255,255,255,0.09); color:#ebebeb; }
  #badge.good { background:rgba(90,220,140,0.18); color:#7ff0ad; }
  #badge.warn { background:rgba(235,235,235,0.20); color:#ebebeb; }
  .stat { clear:both; padding-top:18px; margin-top:18px; border-top:1px solid rgba(255,255,255,0.08); font-size:13px; color:#ebebeb; }
  .stat b { color:#ffffff; font-weight:600; float:right; max-width:200px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }

  /* ---------- panel pages ---------- */
  .panel { position:absolute; left:50%; margin-left:-300px; top:50px; width:600px; }
  .panel h2 { font-size:34px; font-weight:700; margin:0 0 6px 0; color:#ffffff; letter-spacing:-0.5px; }
  .panel p.sub { color:#ebebeb; margin:0 0 22px 0; }
  select, input[type=text] { width:100%; height:40px; background:rgba(19,19,21,0.7); color:#ffffff; border:1px solid rgba(255,255,255,0.14);
                             border-radius:8px; padding:0 12px; font-family:"Segoe UI", Arial, sans-serif; font-size:13px; }
  #file { width:100%; margin-top:12px; color:#ebebeb; font-size:12px; }
  .hint { font-size:12px; color:#ebebeb; margin-top:12px; line-height:1.5; }
  textarea { width:100%; height:270px; background:rgba(19,19,21,0.8); color:#ebebeb; border:1px solid rgba(255,255,255,0.12);
             border-radius:10px; padding:12px; font-family:Consolas, monospace; font-size:11px; }

  /* ---------- lists (mods / saves) ---------- */
  .card .list { max-height:300px; overflow:auto; margin:-8px -10px; padding:0; }
  .item { padding:12px 14px; border-bottom:1px solid rgba(255,255,255,0.07); overflow:hidden; }
  .item:last-child { border-bottom:0; }
  .item:hover { background:rgba(255,255,255,0.05); }
  .iname { display:block; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-weight:600; color:#ffffff; }
  .imeta { float:right; margin-left:16px; font-size:12px; color:#ebebeb; padding-top:2px; }
  .empty { padding:26px 10px; text-align:center; color:#ebebeb; line-height:1.6; }
  .toolrow { margin-top:14px; }
  .toolrow .btn { margin-right:8px; }

  /* ---------- settings rows ---------- */
  #page_settings .card { margin-bottom:16px; }
  .srow { overflow:hidden; padding:13px 0; border-bottom:1px solid rgba(255,255,255,0.07); }
  .srow:last-child { border-bottom:0; }
  .sname { float:left; font-weight:600; color:#ffffff; max-width:380px; }
  .sdesc { display:block; font-weight:400; font-size:12px; color:#ebebeb; margin-top:3px; }
  .srow input[type=checkbox] { float:right; width:20px; height:20px; margin-top:4px; }
  select.ssel { float:right; width:170px; }

  /* ---------- cape thumbnails ---------- */
  .capelist { margin:6px 0 14px 0; overflow:hidden; }
  .capeitem { float:left; width:112px; margin:6px 12px 6px 0; text-align:center; }
  .capeitem img { width:96px; height:48px; border-radius:6px; background:#29292d; border:1px solid rgba(255,255,255,0.12); }
  .capename { font-size:11px; color:#ebebeb; margin-top:4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

  /* ---------- mod rows (logo + name) ---------- */
  .modrow { overflow:hidden; padding:11px 14px; }
  .micon { float:left; width:46px; height:46px; margin-right:14px; border-radius:9px; background:#29292d;
           text-align:center; line-height:46px; font-weight:700; font-size:20px; color:#ebebeb; overflow:hidden; }
  .micon img { width:46px; height:46px; }
  .mtext { overflow:hidden; padding-top:3px; }
  .mdesc { font-size:12px; color:#ebebeb; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:2px; }
  .mtag { float:right; margin-left:12px; padding:2px 10px; border-radius:10px; font-size:11px; background:rgba(255,255,255,0.09); color:#ebebeb; }
  .mtag.built { background:rgba(235,235,235,0.28); color:#ebebeb; }

  #pbar { height:8px; border-radius:4px; background:rgba(255,255,255,0.10); overflow:hidden; }
  #pfill { height:8px; width:0; background:#ebebeb; }
  #code { font-size:34px; font-weight:700; letter-spacing:6px; color:#ebebeb; }
  .btn.small { margin-right:8px; }

  /* ---------- status ---------- */
  #bar { position:absolute; left:100px; bottom:12px; z-index:5; padding:6px 14px; border-radius:14px;
         background:rgba(21,21,24,0.78); font-size:12px; color:#ebebeb; max-width:620px; }
  #status.bad { color:#ebebeb; }

  /* ---------- v38 Lunar / OneConfig layout ---------- */
  #side { width:64px; background:rgba(11,11,11,0.92); }
  #slogo { height:78px; padding-top:14px; }
  #slogo img { width:38px; height:38px; }
  .sn { width:44px; height:44px; margin:6px 10px; padding-top:0; border-radius:12px; }
  .sn svg { width:22px; height:22px; margin:11px auto 0 auto; }
  .sn span { display:none; }
  .sn.on { background:#ebebeb; }
  .sn.on svg { stroke:#ffffff; }
  .sn.on:before { display:none; }
  .sn:hover { background:rgba(235,235,235,0.30); }
  .sn.on:hover { background:#ebebeb; }
  .page { left:64px; }
  #bar { left:80px; }
  #promo { left:0; right:0; top:0; height:30px; border-radius:0; border:0; background:#ebebeb; padding:0 16px; line-height:30px; }
  #promobadge { background:rgba(0,0,0,0.28); color:#ffffff; border:0; padding:2px 10px; line-height:14px; font-size:11px; }
  #promotext { width:620px; line-height:30px; } #promotext b { color:#ffffff; } #promodesc { color:#ebebeb; }
  #promobtn { margin:3px 34px 0 0; background:rgba(0,0,0,0.28); height:24px; padding:0 12px; font-size:12px; }
  #promox { position:absolute; right:10px; top:0; width:20px; height:30px; line-height:28px; color:#ffffff; font-size:18px; cursor:pointer; text-align:center; }
  #hhead { left:28px; top:46px; }
  #hero { left:28px; right:auto; width:576px; top:118px; height:240px; }
  #herotext { left:26px; top:24px; width:520px; }
  #herotitle { font-size:34px; }
  #herodesc { width:380px; margin:6px 0 18px 0; }
  #herobtn { height:52px; padding:0 40px; font-size:16px; }
  #hsrv { position:absolute; right:28px; top:118px; width:276px; height:240px; border-radius:16px; background:rgba(15,15,15,0.86); border:1px solid rgba(255,255,255,0.10); padding:14px 14px 0 14px; overflow:hidden; }
  #hsrvh { font-size:11px; font-weight:700; letter-spacing:1.4px; color:#ebebeb; margin-bottom:8px; }
  .hs { height:40px; margin-bottom:4px; border-radius:10px; padding:4px 6px; background:rgba(255,255,255,0.04); overflow:hidden; cursor:pointer; }
  .hs:hover { background:rgba(235,235,235,0.20); }
  .hs img { float:left; width:32px; height:32px; border-radius:6px; margin-right:10px; background:#161616; }
  .hs b { display:block; font-size:13px; color:#ffffff; line-height:16px; padding-top:2px; } .hs span { font-size:11px; color:#ebebeb; }
  .hs i { float:right; font-style:normal; font-size:11px; font-weight:700; color:#ffffff; background:#ebebeb; padding:3px 10px; border-radius:8px; margin-top:6px; }
  #hnewshead { left:28px; top:380px; }
  #hnews { left:28px; right:28px; top:402px; }
  .ncard { width:270px; margin-right:20px; height:112px; background:rgba(15,15,15,0.86); }
  /* mods grid */
  #modList .modrow { float:left; position:relative; width:196px; height:118px; margin:0 12px 12px 0; padding:12px; border-radius:14px; overflow:hidden; background:rgba(15,15,15,0.86); border:1px solid rgba(255,255,255,0.10); }
  #modList .modrow:hover { border-color:#ebebeb; }
  #modList .micon { float:none; margin:0 0 8px 0; width:38px; height:38px; line-height:38px; }
  #modList .micon img { width:38px; height:38px; }
  #modList .mtext { padding:0; } #modList .iname { font-size:14px; font-weight:700; color:#ffffff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  #modList .mtag { position:absolute; float:none; left:0; right:0; bottom:0; margin:0; border-radius:0; text-align:center; padding:3px 0; background:rgba(255,255,255,0.08); }
  #modList .mtag.built { background:#ebebeb; color:#ffffff; }
  #modsearch { width:220px; margin:0 8px 10px 0; }
  #logwin { position:absolute; left:150px; top:50px; width:700px; height:580px; border-radius:14px; overflow:hidden; background:#ffffff; border:1px solid #ebebeb; }
  #logbar { height:34px; line-height:34px; padding-left:16px; background:#0f0f0f; color:#ffffff; font-size:13px; font-weight:700; }
  #logx { position:absolute; right:0; top:0; width:40px; height:34px; text-align:center; font-size:20px; cursor:pointer; }
  #logcode { position:absolute; right:50px; top:0; font-size:12px; font-weight:400; color:#ebebeb; cursor:pointer; }
  #wbhost { position:absolute; left:0; right:0; top:34px; bottom:0; }
  /* ---------- v41 versions page (OneClient style) ---------- */
  #vtabs { position:absolute; left:34px; top:96px; width:560px; height:34px; border-bottom:1px solid rgba(255,255,255,0.08); }
  .vtab { display:inline-block; padding:6px 4px; margin-right:22px; font-size:13px; color:#ebebeb; cursor:pointer; }
  .vtab:hover { color:#ffffff; } .vtab.on { color:#ffffff; border-bottom:2px solid #ebebeb; }
  #vsearch { position:absolute; right:0; top:0; width:170px; height:28px; border-radius:8px; border:1px solid rgba(255,255,255,0.12); background:rgba(15,15,15,0.86); color:#ffffff; padding:0 10px; font-size:12px; }
  #vgrid { top:146px; width:580px; }
  .vc { width:176px; height:116px; margin:0 12px 12px 0; border-radius:12px; }
  .vc .vband { height:44px; background:rgba(10,10,10,0.62); }
  .vc .vname { font-size:18px; bottom:6px; }
  .vc .vsub { display:none; }
  .vc.on { border-color:#ebebeb; }
  /* ---------- v43 Lunar launchpad home ---------- */
  #topbar { position:absolute; left:14px; right:14px; top:10px; height:50px; }
  #qp { position:absolute; left:0; top:0; right:230px; height:50px; border-radius:12px; background:rgba(21,21,21,0.92); border:1px solid rgba(255,255,255,0.08); padding:0 16px; line-height:50px; overflow:hidden; white-space:nowrap; }
  #qplabel { font-size:11px; font-weight:800; letter-spacing:1px; color:#ffffff; margin-right:20px; vertical-align:middle; }
  .qpi { width:32px; height:32px; margin-right:18px; border-radius:6px; vertical-align:middle; cursor:pointer; background:#1e1e1e; }
  #acctpill { position:absolute; right:0; top:0; width:214px; height:50px; border-radius:12px; background:#ebebeb; cursor:pointer; overflow:hidden; }
  #acctimg { position:absolute; left:8px; top:8px; border-radius:6px; background:#565656; }
  #acctsmall { position:absolute; left:52px; top:7px; font-size:10px; color:#ebebeb; font-style:italic; }
  #wname { position:absolute; left:52px; top:20px; font-size:15px; font-weight:800; color:#ffffff; letter-spacing:0.5px; }
  #promo { left:14px; right:14px; top:68px; height:30px; border-radius:8px; background:#ebebeb; line-height:30px; padding:0 14px; }
  #promotext { width:640px; text-align:left; }
  #promox { right:6px; }
  #hero { left:14px; right:14px; top:106px; width:auto; height:200px; border-radius:14px; }
  #herotext { display:none; }
  #herogl1 { position:absolute; right:-40px; bottom:-90px; width:380px; height:260px; border-radius:190px; background:rgba(235,235,235,0.22); }
  #herogl2 { position:absolute; left:-60px; top:-80px; width:300px; height:200px; border-radius:150px; background:rgba(235,235,235,0.12); }
  #herobtn { position:absolute; left:50%; top:62px; width:290px; margin-left:-145px; height:68px; border-radius:10px; font-size:24px; font-weight:800; letter-spacing:1px; padding:0; background:#ebebeb; }
  #herobtn:hover { background:#ebebeb; }
  #herorty { display:block; font-size:10px; font-weight:600; letter-spacing:1.5px; color:#ebebeb; margin-top:-2px; }
  #herosub { position:absolute; left:0; right:0; top:140px; text-align:center; font-size:12px; color:#ebebeb; }
  #herosub #herotitle { font-size:12px; line-height:16px; color:#ffffff; letter-spacing:0; font-weight:700; }
  #heroalt { position:absolute; left:0; right:0; top:164px; text-align:center; height:auto; padding:0; background:none; font-size:12px; color:#ebebeb; cursor:pointer; }
  #heroalt:hover { color:#ffffff; }
  #hnewshead { left:14px; top:322px; font-size:15px; font-weight:800; letter-spacing:0; color:#ffffff; }
  #hnews { left:14px; right:auto; width:650px; top:352px; }
  .ncard { width:292px; height:150px; margin-right:14px; float:left; padding:18px 20px; border-radius:14px; background:rgba(21,21,21,0.92); }
  .ncard .ntitle { font-size:19px; }
  #hsrv { right:14px; top:322px; width:256px; height:262px; border:0; background:transparent; padding:0; }
  #hsrvh { font-size:15px; font-weight:800; letter-spacing:0; color:#ffffff; margin-bottom:12px; }
  .hs { height:44px; margin-bottom:6px; padding:6px 8px; background:transparent; }
  .hs img { width:32px; height:32px; }
  #nav_saves, #nav_account, #nav_log { display:none; }
  #nav_settings { position:absolute; left:0; bottom:38px; margin:0 10px; }
  .sn { margin:10px 10px; }
  /* ---------- welcome screen ---------- */
  #welcome { position:absolute; left:0; top:34px; right:0; bottom:0; z-index:40; background:#0b0b0d; }
  #wart { position:absolute; left:0; top:0; bottom:0; width:560px; background-size:cover; background-repeat:no-repeat; background-position:center; }
  #wpanel { position:absolute; left:560px; top:0; right:0; bottom:0; background:#101012; padding:28px 34px; border-left:1px solid rgba(255,255,255,0.08); }
  #wclose { position:absolute; right:14px; top:8px; font-size:22px; color:#a8a8ad; cursor:pointer; }
  #wclose:hover { color:#ffffff; }
  #wlogo { margin-bottom:26px; }
  .wf { margin-bottom:22px; height:62px; }
  .wf b { display:block; font-size:15px; color:#ffffff; margin-bottom:4px; }
  .wf span { display:block; font-size:12px; line-height:1.5; color:#a8a8ad; width:330px; }
  #wlogin { position:absolute; left:34px; right:34px; bottom:96px; height:48px; font-size:15px; font-weight:700; background:#f2f2f2; color:#0a0a0a; border-radius:8px; }
  #wlogin:hover { background:#ffffff; }
  #wguest { position:absolute; left:34px; right:34px; bottom:40px; height:44px; font-size:14px; font-weight:600; background:rgba(255,255,255,0.10); color:#ffffff; border-radius:8px; }
  #wguest:hover { background:rgba(255,255,255,0.18); }
  #wfoot { position:absolute; left:0; right:0; bottom:12px; text-align:center; font-size:11px; color:#6c6c72; }
  /* black and white: dark text on the light accent buttons */
  .sn.on svg { stroke:#0a0a0a; }
  #herobtn, #playbtn, #promobtn, #acctpill, #wname, .hs i { color:#0a0a0a; }
  #herorty, #acctsmall, #promobadge, #promodesc, #promotext b, #promotext { color:#2a2a2d; }
  #promo, #acctpill { background:#f2f2f2; }
  #promox { color:#0a0a0a; }
  /* ---------- v45 Lunar launchpad layout ---------- */
  #hwelcome { position:absolute; left:20px; top:14px; font-size:15px; color:#d8d8dc; }
  #hwelcome #wname { position:static; display:inline; font-size:15px; font-weight:800; color:#ffffff; letter-spacing:0; }
  #wcaret { color:#a8a8ad; cursor:pointer; margin-left:4px; }
  #hero { left:14px; top:46px; right:auto; width:600px; height:232px; border-radius:14px; border:1px solid rgba(255,255,255,0.10); }
  #herobtn { top:76px; width:300px; margin-left:-150px; height:62px; font-size:22px; }
  #herosub { top:150px; } #heroalt { top:176px; }
  #qpbar { position:absolute; left:14px; top:288px; width:600px; height:48px; border-radius:12px; background:rgba(16,16,18,0.92); border:1px solid rgba(255,255,255,0.08); padding:8px 16px; overflow:hidden; white-space:nowrap; }
  #qpbar .qpi { width:30px; height:30px; margin-right:26px; }
  #hnewshead { left:20px; top:350px; font-size:14px; font-weight:800; }
  #hnews { left:14px; top:378px; width:650px; }
  .ncard { width:292px; height:140px; }
  #hsrv { left:630px; right:auto; top:46px; width:292px; height:372px; border-radius:14px; background:rgba(16,16,18,0.92); border:1px solid rgba(255,255,255,0.08); padding:16px 14px; }
  #hsrvh { font-size:15px; font-weight:800; color:#ffffff; margin-bottom:12px; }
  #promo { left:630px; right:auto; top:430px; width:292px; height:120px; border-radius:14px; background:rgba(16,16,18,0.92); border:1px solid rgba(255,255,255,0.08); padding:14px; line-height:1.4; }
  #promo > * { display:block; }
  #promotext { width:auto; white-space:normal; margin:8px 0; color:#ffffff; } #promotext b { color:#ffffff; display:block; }
  #promodesc { color:#a8a8ad; }
  #promobadge { display:inline-block; background:rgba(255,255,255,0.14); color:#ffffff; }
  #promobtn { float:none; margin:0; background:#f2f2f2; color:#0a0a0a; height:30px; }
  #promox { right:10px; top:6px; color:#a8a8ad; }
  #cmdbox { position:absolute; left:80px; right:16px; bottom:16px; z-index:60; border-radius:12px; background:rgba(8,8,9,0.97); border:1px solid rgba(255,255,255,0.18); padding:10px 14px; }
  #cmdout { max-height:170px; overflow:auto; font-family:Consolas,monospace; font-size:12px; line-height:1.5; color:#c8c8cc; margin-bottom:8px; white-space:pre-wrap; }
  #cmdrow { height:30px; line-height:28px; border-top:1px solid rgba(255,255,255,0.10); padding-top:6px; }
  #cmdp { color:#ffffff; font-family:Consolas,monospace; font-weight:700; margin-right:6px; }
  #cmdin { width:90%; background:transparent; border:0; outline:none; color:#ffffff; font-family:Consolas,monospace; font-size:13px; }
</style>
<script language="JScript">
// Reads the official Minecraft launcher's saved account list on this PC.
// Login tokens are never read out, shown or copied. The log only shows
// file names, account type, e-mail/username and Minecraft profile name.

var fso = new ActiveXObject("Scripting.FileSystemObject");
var sh  = new ActiveXObject("WScript.Shell");
var appData = sh.ExpandEnvironmentStrings("%APPDATA%");
var cfgDir  = appData + "\\MiniClientHTA";
var cfgFile = cfgDir + "\\config.json";
var mcDir   = appData + "\\.minecraft";
var cfg = { launcherPath: "", refreshToken: "" };
var CLIENT_ID = "29c987d8-cae7-4e10-a1c8-5a43e7f6651b";
var verified = false;
var pollTimer = null;
var found = [];
var logLines = [];
var ownsGame = null;

function $(id) { return document.getElementById(id); }
function log(s) {
  logLines.push(s);
  try { $("log").value = logLines.join("\r\n"); } catch (e) {}
  // also keep a copy on disk: %APPDATA%\MiniClientHTA\client.log (never contains tokens)
  try {
    if (!fso.FolderExists(cfgDir)) fso.CreateFolder(cfgDir);
    var lf2 = fso.OpenTextFile(cfgDir + "\\client.log", 8, true);
    lf2.WriteLine(s); lf2.Close();
  } catch (e) {}
}
window.onerror = function (msg, url, line) {
  try { setStatus("Script error: " + msg + " (line " + line + "). See the Log tab.", true); log("Script error: " + msg + " at line " + line); } catch (e) {}
  return true;
};
function setStatus(msg, bad) {
  $("status").innerText = msg;
  $("status").className = bad ? "bad" : "";
}

// ---------- pixel scenery (own artwork, drawn with plain boxes) ----------
var seed = 11;
function rnd() { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; }
function box(parent, l, t, w, h, c) {
  var d = document.createElement("div");
  d.style.position = "absolute";
  d.style.left = Math.round(l) + "px"; d.style.top = Math.round(t) + "px";
  d.style.width = Math.round(w) + "px"; d.style.height = Math.round(h) + "px";
  d.style.background = c;
  parent.appendChild(d);
  return d;
}
function mix(a, b, t) { // hex colours as [r,g,b]
  return "rgb(" + Math.round(a[0] + (b[0] - a[0]) * t) + "," + Math.round(a[1] + (b[1] - a[1]) * t) + "," + Math.round(a[2] + (b[2] - a[2]) * t) + ")";
}
function hills(sky, W, H, color, base, amp, colW, trees) {
  var h = base;
  for (var x = 0; x < W; x += colW) {
    h += (rnd() - 0.5) * amp;
    if (h < base * 0.55) h = base * 0.55;
    if (h > base * 1.45) h = base * 1.45;
    var q = Math.round(h / colW) * colW;
    box(sky, x, H - q, colW, q, color);
    if (trees && rnd() < 0.09) {
      var th = 18 + Math.round(rnd() * 3) * 6;
      box(sky, x + colW / 2 - 3, H - q - 10, 6, 12, color);
      box(sky, x + 2, H - q - 10 - th, colW - 4, th, color);
      box(sky, x + 6, H - q - 10 - th - 6, colW - 12, 6, color);
    }
  }
}
var BG_DATA = "data:image/jpeg;base64,";
var petals = [], pTimer = 0;
function buildScene() {
  var sky = $("sky");
  if (sky.getAttribute("data-bg")) return;
  sky.setAttribute("data-bg", "1");
  sky.innerHTML = "<img src=\"" + BG_DATA + "\" style=\"position:absolute;left:0;top:0;width:100%;height:100%;-ms-interpolation-mode:nearest-neighbor;\" />";
  // dark cherry fade so the white text and the cards stay easy to read on the bright picture
  // falling petals
  var W = document.body.clientWidth || 1000, H = document.body.clientHeight || 680, i, d;
  var cols = ["#ebebeb", "#ebebeb", "#ebebeb", "#ebebeb"];
  for (i = 0; i < 22; i++) {
    d = document.createElement("div");
    var sz = 4 + Math.floor(Math.random() * 4);
    d.style.cssText = "position:absolute;width:" + sz + "px;height:" + Math.round(sz * 0.7) + "px;background:" + cols[i % 4] + ";";
    petals.push({ el: d, x: Math.random() * W, y: Math.random() * H, vy: 0.8 + Math.random() * 1.2, vx: -0.3 - Math.random() * 0.7, ph: Math.random() * 6.28 });
    sky.appendChild(d);
  }
  if (pTimer) clearInterval(pTimer);
  var tick = 0;
  pTimer = setInterval(function () {
    tick++;
    for (var k = 0; k < petals.length; k++) {
      var p = petals[k];
      p.y += p.vy; p.x += p.vx + Math.sin(tick * 0.06 + p.ph) * 0.8;
      if (p.y > H + 10) { p.y = -10; p.x = Math.random() * (W + 120); }
      if (p.x < -10) p.x = W + 10;
      p.el.style.left = Math.round(p.x) + "px"; p.el.style.top = Math.round(p.y) + "px";
    }
  }, 60);
}

// ---------- UI helpers ----------
var pages = ["home", "play", "servers", "mods", "saves", "account", "settings", "log"];
function show(name) {
  if (name == "servers") { try { renderServers(); } catch (e) {} }
  for (var i = 0; i < pages.length; i++) {
    var on = (pages[i] == name);
    $("page_" + pages[i]).style.display = on ? "block" : "none";
    $("nav_" + pages[i]).className = on ? "sn on" : "sn";
  }
  if (name == "mods") loadMods();
  if (name == "saves") loadSaves();
}

// ---------- Mods + Saves (read from the .minecraft folder) ----------
function fmtDate(d) {
  d = new Date(d);
  var m = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return d.getDate() + " " + m[d.getMonth()] + " " + d.getFullYear();
}
function fmtSize(b) {
  if (b > 1048576) return (b / 1048576).toFixed(1) + " MB";
  if (b > 1024) return Math.round(b / 1024) + " KB";
  return b + " B";
}
function listDir(sub, folders) {
  var p = gameDir + "\\" + sub, out = [];
  if (!fso.FolderExists(p)) return null;
  var f = fso.GetFolder(p), e;
  if (folders) {
    for (e = new Enumerator(f.SubFolders); !e.atEnd(); e.moveNext())
      out.push({ name: e.item().Name, date: e.item().DateLastModified, size: null });
  } else {
    for (e = new Enumerator(f.Files); !e.atEnd(); e.moveNext()) {
      var n = e.item().Name;
      if (/\.jar(\.disabled)?$/i.test(n))
        out.push({ name: n, date: e.item().DateLastModified, size: e.item().Size });
    }
  }
  out.sort(function (a, b) { return new Date(b.date) - new Date(a.date); });
  return out;
}
function fillList(id, items, emptyMsg, metaFn) {
  var box = $(id);
  box.innerHTML = "";
  if (!items || items.length == 0) {
    var em = document.createElement("div");
    em.className = "empty";
    em.innerText = emptyMsg;
    box.appendChild(em);
    return;
  }
  for (var i = 0; i < items.length; i++) {
    var row = document.createElement("div");
    row.className = "item";
    var meta = document.createElement("span");
    meta.className = "imeta";
    meta.innerText = metaFn(items[i]);
    var nm = document.createElement("span");
    nm.className = "iname";
    nm.innerText = items[i].name;
    row.appendChild(meta);
    row.appendChild(nm);
    box.appendChild(row);
  }
}
function loadSaves() {
  var items = listDir("saves", true);
  $("saveCount").innerText = items ? items.length + " world" + (items.length == 1 ? "" : "s") : "";
  fillList("saveList", items,
    items === null ? "No saves folder found yet. Play Minecraft once and your worlds will show here."
                   : "No worlds yet.",
    function (it) { return "Last played " + fmtDate(it.date); });
}
function openFolder(sub) {
  var p = gameDir + (sub ? "\\" + sub : "");
  if (!fso.FolderExists(p)) { setStatus("That folder does not exist yet.", true); return; }
  sh.Run('explorer.exe "' + p + '"', 1, false);
  setStatus("Opened " + p);
}
function renderBadge() {
  var b = $("badge");
  if (found.length == 0) { b.innerText = "No account"; b.className = ""; return; }
  if (verified)           { b.innerText = "Verified with Microsoft"; b.className = "good"; }
  else if (ownsGame === true)  { b.innerText = "Owns Minecraft"; b.className = "good"; }
  else if (ownsGame === false) { b.innerText = "Minecraft not owned"; b.className = "warn"; }
  else { b.innerText = "Account found"; b.className = "good"; }
}

// ---------- file helpers ----------
function readUtf8(path) {
  // Plain FileSystemObject read (ADODB.Stream is blocked by Windows zone security).
  var f = fso.OpenTextFile(path, 1, false, 0);
  var t = f.AtEndOfStream ? "" : f.ReadAll();
  f.Close();
  var i = t.indexOf("{");
  return i > 0 ? t.substring(i) : t;
}
function readRaw(path) {
  var f = fso.OpenTextFile(path, 1, false, 0);
  var t = f.AtEndOfStream ? "" : f.ReadAll();
  f.Close();
  return t;
}
function loadCfg() {
  try {
    if (fso.FileExists(cfgFile)) {
      var c = JSON.parse(readUtf8(cfgFile));
      // ignore a saved path that points at a .hta (e.g. this client itself)
      if (c.launcherPath && !/\.hta$/i.test(c.launcherPath)) cfg.launcherPath = c.launcherPath;
      if (c.refreshToken) cfg.refreshToken = c.refreshToken;
      if (c.version) cfg.version = c.version;
      if (c.updateUrl) cfg.updateUrl = c.updateUrl;
      for (var ck in c) cfg[ck] = c[ck];   // settings: ram, fullscreen, size, mods...
    }
  } catch (e) {}
}
function saveCfg() {
  try {
    if (!fso.FolderExists(cfgDir)) fso.CreateFolder(cfgDir);
    var f = fso.CreateTextFile(cfgFile, true);
    f.Write(JSON.stringify(cfg)); f.Close();
  } catch (e) { setStatus("Could not save settings: " + e.message, true); }
}

function listFolder() {
  log("APPDATA = " + appData);
  log(".minecraft folder exists: " + fso.FolderExists(mcDir));
  if (fso.FolderExists(mcDir)) {
    var names = [];
    var en = new Enumerator(fso.GetFolder(mcDir).Files);
    for (; !en.atEnd(); en.moveNext()) names.push(en.item().Name);
    log("Files in .minecraft: " + (names.join(", ") || "(none)"));
  }
  var hits = [];
  var fe = new Enumerator(fso.GetFolder(appData).SubFolders);
  for (; !fe.atEnd(); fe.moveNext()) {
    var n = fe.item().Name;
    if (/mini|launcher/i.test(n)) hits.push(n);
  }
  log("Other launcher-like folders in APPDATA: " + (hits.join(", ") || "(none)"));
}

function scanFile(path) {
  log("--- " + path);
  if (!fso.FileExists(path)) { log("not found"); return; }
  var data;
  try { data = JSON.parse(readUtf8(path)); }
  catch (e) { log("could not parse: " + e.message); return; }
  var activeId = data.activeAccountLocalId;
  var count = 0;
  function walk(obj, key, depth) {
    if (!obj || typeof obj != "object" || depth > 6) return;
    if (obj.minecraftProfile && obj.minecraftProfile.name) {
      count++;
      log("account: type=" + obj.type + " user=" + (obj.username || "") +
          " profile=" + obj.minecraftProfile.name);
      found.push({ name: obj.minecraftProfile.name, email: obj.username || "",
                   active: (key == activeId) });
      return;
    }
    for (var k in obj) walk(obj[k], k, depth + 1);
  }
  walk(data, "", 0);
  log("accounts with a Minecraft profile in file: " + count);
}

function checkOwnership() {
  var p = mcDir + "\\launcher_entitlements_microsoft_store.json";
  if (!fso.FileExists(p)) { log("entitlements file: not found"); return; }
  try {
    var t = readRaw(p);
    var owns = (t.indexOf("game_minecraft") >= 0) || (t.indexOf("product_minecraft") >= 0);
    log("entitlements file says you own Minecraft: " + owns);
    ownsGame = owns;
  } catch (e) { log("entitlements read failed: " + e.message); }
}

// ---------- account check ----------
function checkAccount() {
  found = []; logLines = []; ownsGame = null;
  var sel = $("accounts");
  sel.options.length = 0;
  $("playbtn").disabled = false; $("herobtn").disabled = false;
  $("who").innerText = "No account";
  $("avatar").innerText = "?";
  $("email").innerText = "";

  mcName = ""; mcToken = ""; skinName = "";

  if (found.length == 0) {
    renderBadge();
    try { renderHome(); renderSelected(); } catch (e0) {}
    setStatus("Sign in with Microsoft to play.");
    return;
  }
  var activeIndex = 0, seen = {}, uniq = [];
  for (var i = 0; i < found.length; i++) {
    if (seen[found[i].name]) continue;
    seen[found[i].name] = 1;
    if (found[i].active) activeIndex = uniq.length;
    uniq.push(found[i]);
  }
  found = uniq;
  for (var j = 0; j < found.length; j++) {
    var o = document.createElement("option");
    o.text = found[j].name + (found[j].email ? "  (" + found[j].email + ")" : "");
    sel.options.add(o);
  }
  sel.selectedIndex = activeIndex;
  pick();
  if (ownsGame === false) setStatus("Account found, but the launcher says it does not own Minecraft.", true);
  else setStatus(ownsGame ? "Microsoft account found. Minecraft is owned." : "Microsoft account found.");
}

function pick() {
  var i = $("accounts").selectedIndex;
  if (i < 0 || !found[i]) return;
  $("who").innerText = found[i].name;
  $("avatar").innerHTML = '<img src="https://mc-heads.net/avatar/' + encodeURIComponent(found[i].name) + '/64" onerror="this.parentNode.innerText=\'' + found[i].name.charAt(0).toUpperCase() + '\'" />';
  $("email").innerText = found[i].email;
  skinName = found[i].name; renderSelected();
  $("playbtn").disabled = false; $("herobtn").disabled = false;
  renderBadge();
}

// ---------- Microsoft sign-in (approved app ID) ----------
function http(method, url, headers, body) {
  var x = new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");
  x.setTimeouts(10000, 10000, 15000, 30000);
  x.open(method, url, false);
  for (var h in headers) x.setRequestHeader(h, headers[h]);
  x.send(body || null);
  var j = null;
  try { j = JSON.parse(x.responseText); } catch (e) {}
  return { status: x.status, json: j, text: x.responseText };
}
function form(o) {
  var a = [];
  for (var k in o) a.push(encodeURIComponent(k) + "=" + encodeURIComponent(o[k]));
  return a.join("&");
}
var FORM_H = { "Content-Type": "application/x-www-form-urlencoded" };
var JSON_H = { "Content-Type": "application/json", "Accept": "application/json" };

// ---------- Microsoft sign-in popup (the real Microsoft page; email + password are typed into Microsoft, never into this app) ----------
var REDIRECT = "https://login.live.com/oauth20_desktop.srf", wbTimer = null, wbVerifier = "", wbState = "";
function randStr(n) { var c = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", o = ""; for (var i = 0; i < n; i++) o += c.charAt(Math.floor(Math.random() * c.length)); return o; }
function startLogin() {
  try {
    if (pollTimer) clearTimeout(pollTimer);
    clearBrowserLogin();
    wbVerifier = randStr(64); wbState = randStr(16);
    var url = "https://login.microsoftonline.com/consumers/oauth2/v2.0/authorize?" + form({
      client_id: CLIENT_ID, response_type: "code", redirect_uri: REDIRECT, response_mode: "query",
      scope: "XboxLive.signin offline_access", prompt: "login", state: wbState,
      code_challenge: wbVerifier, code_challenge_method: "plain" });
    $("loginov").style.display = "block";
    $("wbhost").innerHTML = '<object id="wb" classid="clsid:8856F961-340A-11D0-8F6D-00AA0053D09B" width="100%" height="100%"></object>';
    var wb = $("wb");
    try { wb.Silent = true; } catch (e0) {}
    wb.Navigate(url);
    setStatus("Sign in with your Microsoft account in the window.");
    if (wbTimer) clearInterval(wbTimer);
    wbTimer = setInterval(checkWb, 400);
  } catch (e) { closeLogin(); log("Popup sign-in unavailable: " + e.message); setStatus("The sign-in window could not open. Open the Log page for details.", true); }
}
function checkWb() {
  try {
    var u = String($("wb").LocationURL || "");
    if (u.indexOf("oauth20_desktop.srf") < 0) return;
    var q = u.split("?")[1] || "", m = /(?:^|&)code=([^&#]+)/.exec(q), er = /(?:^|&)error=([^&#]+)/.exec(q);
    if (!m && !er) return;
    closeLogin();
    if (er) { setStatus("Sign-in failed: " + decodeURIComponent(er[1]), true); return; }
    setStatus("Finishing sign-in...");
    var r = http("POST", "https://login.microsoftonline.com/consumers/oauth2/v2.0/token", FORM_H,
      form({ grant_type: "authorization_code", client_id: CLIENT_ID, code: decodeURIComponent(m[1]), redirect_uri: REDIRECT,
             code_verifier: wbVerifier, scope: "XboxLive.signin offline_access" }));
    if (r.status == 200) afterMsToken(r.json);
    else { log("Popup token error: " + String(r.text).substring(0, 300)); setStatus("Microsoft refused the sign-in. Open the Log page for details.", true); }
  } catch (e) {}
}
// ---------- F8 command console ----------
function cmdOut(t) { var o = $("cmdout"); o.innerText = (o.innerText ? o.innerText + "\n" : "") + t; o.scrollTop = o.scrollHeight; }
function toggleCmd() {
  var b = $("cmdbox"), on = (b.style.display == "none");
  b.style.display = on ? "block" : "none";
  if (on) { if (!$("cmdout").innerText) cmdOut("Mini Client commands. Type /help"); try { $("cmdin").focus(); } catch (e) {} }
}
function cmdKey(e) {
  e = e || window.event;
  if (e.keyCode == 13) { var v = $("cmdin").value; $("cmdin").value = ""; runCmd(v); }
  else if (e.keyCode == 27) toggleCmd();
}
function runCmd(line) {
  line = String(line).replace(/^\s+|\s+$/g, "").replace(/^\//, "");
  if (!line) return;
  cmdOut("> /" + line);
  var parts = line.split(/\s+/), c = parts[0].toLowerCase(), a = parts.slice(1);
  if (c == "sign" && a.length && a[0].toLowerCase() == "out") { c = "signout"; a = a.slice(1); }
  var arg = a.join(" ");
  try {
    if (c == "help") cmdOut("/help                 show this list\n/sign out [name]     sign out (name is optional)\n/whoami               who is signed in\n/update               check for an update\n/servers              list your servers\n/join <name>          launch and join a server\n/play                 launch the game\n/fps on|off          turn the FPS boost on or off\n/open <page>          home, versions, servers, mods, saves, account, settings, log\n/clear                clear this window\n/quit                 close Mini Client");
    else if (c == "signout" || c == "logout") {
      if (arg && mcName && arg.toLowerCase() != mcName.toLowerCase()) { cmdOut("Signed in as " + mcName + ", not " + arg + "."); return; }
      var who = mcName || "nobody"; signOut(); cmdOut("Signed out " + who + ".");
    }
    else if (c == "whoami") cmdOut(mcName ? "Signed in as " + mcName : "Not signed in.");
    else if (c == "update") { checkUpdate(true); cmdOut("Checking for updates... v" + APP_VERSION); }
    else if (c == "servers") { var l = getServers(), i; for (i = 0; i < l.length; i++) cmdOut((i + 1) + ". " + l[i][0] + "  " + l[i][1]); }
    else if (c == "join") {
      var l2 = getServers(), q = arg.toLowerCase(), k, hit = -1;
      for (k = 0; k < l2.length; k++) if (l2[k][0].toLowerCase().indexOf(q) >= 0 || l2[k][1].toLowerCase() == q) { hit = k; break; }
      if (hit < 0 || !q) cmdOut("No server called " + arg + "."); else { cmdOut("Joining " + l2[hit][0] + "..."); toggleCmd(); joinServer(hit); }
    }
    else if (c == "play") { toggleCmd(); play(); }
    else if (c == "fps") { cfg.fpsBoost = (a[0] != "off"); saveCfg(); applySettingsToUI(); cmdOut("FPS boost " + (cfg.fpsBoost ? "on" : "off") + "."); }
    else if (c == "open") {
      var m = { home: "home", versions: "play", play: "play", servers: "servers", mods: "mods", saves: "saves", account: "account", settings: "settings", log: "log" };
      if (m[a[0]]) { show(m[a[0]]); cmdOut("Opened " + a[0] + "."); } else cmdOut("Unknown page.");
    }
    else if (c == "clear") $("cmdout").innerText = "";
    else if (c == "quit") window.close();
    else cmdOut("Unknown command. Type /help");
  } catch (e) { cmdOut("Error: " + e.message); }
}
function closeWelcome() { try { $("welcome").style.display = "none"; } catch (e) {} }
function closeLogin() {
  if (wbTimer) { clearInterval(wbTimer); wbTimer = null; }
  try { $("wbhost").innerHTML = ""; } catch (e) {}
  $("loginov").style.display = "none";
}
function codeInstead() { closeLogin(); startCodeLogin(); }
function startCodeLogin() {
  try {
    if (pollTimer) clearTimeout(pollTimer);
    setStatus("Requesting sign-in code...");
    var r = http("POST", "https://login.microsoftonline.com/consumers/oauth2/v2.0/devicecode", FORM_H,
      form({ client_id: CLIENT_ID, scope: "XboxLive.signin offline_access" }));
    if (r.status != 200) { setStatus("Sign-in code failed: " + r.text, true); return; }
    var d = r.json;
    $("code").innerText = d.user_code;
    $("link").innerText = d.verification_uri;
    $("codebox").style.display = "block";
    show("account");
    setStatus("Enter the code on the Microsoft page that just opened...");
    try { sh.Run(d.verification_uri, 1, false); } catch (e) {}
    pollLogin(d.device_code, (d.interval || 5) * 1000, new Date().getTime() + d.expires_in * 1000);
  } catch (e) { setStatus("Sign-in error: " + e.message, true); }
}
function pollLogin(deviceCode, ms, deadline) {
  pollTimer = setTimeout(function () {
    try {
      if (new Date().getTime() > deadline) { setStatus("Code expired. Click Sign in again.", true); return; }
      var r = http("POST", "https://login.microsoftonline.com/consumers/oauth2/v2.0/token", FORM_H,
        form({ grant_type: "urn:ietf:params:oauth:grant-type:device_code", client_id: CLIENT_ID, device_code: deviceCode }));
      if (r.status == 200) { $("codebox").style.display = "none"; afterMsToken(r.json); return; }
      var err = r.json && r.json.error;
      if (err == "authorization_pending") { pollLogin(deviceCode, ms, deadline); return; }
      if (err == "slow_down") { pollLogin(deviceCode, ms + 5000, deadline); return; }
      setStatus("Sign-in failed: " + (err || r.text), true);
    } catch (e) { setStatus("Sign-in error: " + e.message, true); }
  }, ms);
}
function trySilentLogin() {
  if (!cfg.refreshToken) return;
  try {
    setStatus("Checking saved Microsoft login...");
    var r = http("POST", "https://login.microsoftonline.com/consumers/oauth2/v2.0/token", FORM_H,
      form({ grant_type: "refresh_token", client_id: CLIENT_ID, refresh_token: cfg.refreshToken,
             scope: "XboxLive.signin offline_access" }));
    if (r.status == 200) afterMsToken(r.json);
    else { cfg.refreshToken = ""; saveCfg(); setStatus("Saved login expired. Click Sign in with Microsoft."); }
  } catch (e) { setStatus("Could not check saved login: " + e.message, true); }
}
function afterMsToken(t) {
  if (t.refresh_token) { cfg.refreshToken = t.refresh_token; saveCfg(); }
  setStatus("Checking Xbox profile...");
  var xbl = http("POST", "https://user.auth.xboxlive.com/user/authenticate", JSON_H, JSON.stringify({
    Properties: { AuthMethod: "RPS", SiteName: "user.auth.xboxlive.com", RpsTicket: "d=" + t.access_token },
    RelyingParty: "http://auth.xboxlive.com", TokenType: "JWT" }));
  if (xbl.status != 200) { setStatus("Xbox auth failed (" + xbl.status + ").", true); return; }
  var uhs = xbl.json.DisplayClaims.xui[0].uhs;

  var xsts = http("POST", "https://xsts.auth.xboxlive.com/xsts/authorize", JSON_H, JSON.stringify({
    Properties: { SandboxId: "RETAIL", UserTokens: [xbl.json.Token] },
    RelyingParty: "rp://api.minecraftservices.com/", TokenType: "JWT" }));
  if (xsts.status != 200) {
    var xe = xsts.json && xsts.json.XErr, m = "XSTS failed (" + xsts.status + ").";
    if (xe == 2148916233) m = "This Microsoft account has no Xbox profile. Sign in once at xbox.com to create one.";
    if (xe == 2148916238) m = "Child account: add it to a Microsoft Family first.";
    setStatus(m, true); return;
  }

  setStatus("Logging in to Minecraft services...");
  var mc = http("POST", "https://api.minecraftservices.com/authentication/login_with_xbox", JSON_H,
    JSON.stringify({ identityToken: "XBL3.0 x=" + uhs + ";" + xsts.json.Token }));
  if (mc.status != 200) {
    // Log Mojang's reply (it contains no tokens) so the reason is visible.
    log("Minecraft login reply (" + mc.status + "): " + String(mc.text).substring(0, 400));
    setStatus("Minecraft login failed (" + mc.status + "). Open the Log tab and send it to Claude.", true);
    return;
  }
  var auth = { "Authorization": "Bearer " + mc.json.access_token, "Accept": "application/json" };
  var ent = http("GET", "https://api.minecraftservices.com/entitlements/mcstore", auth);
  var owns = false;
  if (ent.json && ent.json.items) {
    for (var i = 0; i < ent.json.items.length; i++) {
      var n = ent.json.items[i].name;
      if (n == "game_minecraft" || n == "product_minecraft") owns = true;
    }
  }
  var prof = http("GET", "https://api.minecraftservices.com/minecraft/profile", auth);
  var name = (prof.status == 200 && prof.json) ? prof.json.name : null;

  if (owns && name) {
    verified = true;
    closeWelcome();
    ownsGame = true;
    mcToken = mc.json.access_token;           // kept in memory only, never logged
    mcUuid = (prof.json && prof.json.id) ? prof.json.id : "";
    mcName = name;
    mcTime = new Date().getTime();
    found = [{ name: name, email: "Verified with Microsoft", active: true }];
    var sel = $("accounts");
    sel.options.length = 0;
    var o = document.createElement("option");
    o.text = name;
    sel.options.add(o);
    sel.selectedIndex = 0;
    pick();
    log("Microsoft login OK: " + name + " (owns Minecraft)");
    setStatus("Signed in with Microsoft. Minecraft is owned.");
  } else if (!owns) {
    setStatus("Signed in, but this account does not own Minecraft Java.", true);
  } else {
    setStatus("You own the game but have no Minecraft profile yet. Create one in the official launcher once.", true);
  }
}
function clearBrowserLogin() {
  try { sh.Run("RunDll32.exe InetCpl.cpl,ClearMyTracksByProcess 2", 0, true); } catch (e) {}     // cookies
  try { sh.Run("RunDll32.exe InetCpl.cpl,ClearMyTracksByProcess 8", 0, true); } catch (e) {}     // temporary files
}
function signOut() {
  clearBrowserLogin();
  cfg.refreshToken = ""; saveCfg(); verified = false; ownsGame = null;
  checkAccount();
  try { $("welcome").style.display = "block"; } catch (e0) {}
  setStatus("Signed out of Microsoft on this client.");
}

// ---------- Game launcher (downloads Minecraft + Java, then starts it) ----------
var gameDir = mcDir;   // shared with the official launcher (.minecraft): versions, libraries, assets, saves, mods
var mcToken = "", mcUuid = "", mcName = "", mcTime = 0;
var versionList = null;
var busy = false;
var useCurl = false;
var ctx = null;
var tPlay = 0;

var archEnv = sh.ExpandEnvironmentStrings("%PROCESSOR_ARCHITEW6432%");
if (archEnv.charAt(0) == "%") archEnv = sh.ExpandEnvironmentStrings("%PROCESSOR_ARCHITECTURE%");
var archKey = (archEnv == "ARM64") ? "arm64" : (archEnv == "x86" ? "x86" : "x64");
var rtPlatform = { arm64: "windows-arm64", x86: "windows-x86", x64: "windows-x64" }[archKey];
var RT_INDEX = "https://launchermeta.mojang.com/v1/products/java-runtime/2ec0cc96c44e5a76b9c8b7c39df7210883d12871/all.json";
var VERSIONS_URL = "https://piston-meta.mojang.com/mc/game/version_manifest_v2.json";

function fwd(p) { return String(p).replace(/\\/g, "/"); }
function mkdirs(p) {
  if (fso.FolderExists(p)) return;
  var parent = fso.GetParentFolderName(p);
  if (parent && !fso.FolderExists(parent)) mkdirs(parent);
  fso.CreateFolder(p);
}
function getJson(url) {
  var r = http("GET", url, {});
  if (r.status != 200 || !r.json) throw new Error("HTTP " + r.status + " for " + url);
  return r.json;
}
function dl(url, path) {
  mkdirs(fso.GetParentFolderName(path));
  if (!useCurl) {
    try {
      var x = new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");
      x.setTimeouts(15000, 15000, 30000, 120000);
      x.open("GET", url, false);
      x.send();
      if (x.status != 200) throw new Error("HTTP " + x.status);
      var s = new ActiveXObject("ADODB.Stream");
      s.Type = 1; s.Open(); s.Write(x.responseBody); s.SaveToFile(path, 2); s.Close();
      return;
    } catch (e) {
      if (String(e.message).indexOf("HTTP") == 0) throw e;
      log("Direct file save not allowed here (" + e.message + "). Using Windows' built-in curl.exe instead.");
      useCurl = true;
    }
  }
  var rc = sh.Run('curl.exe -L -s -f -o "' + path + '" "' + url + '"', 0, true);
  if (rc != 0 || !fso.FileExists(path)) throw new Error("curl failed (" + rc + ") for " + url);
}

// rules: Mojang's allow/disallow lists. Only Windows rules match; "features" (demo mode, etc.) are all off.
function rulesOk(rules) {
  if (!rules) return true;
  var ok = false;
  for (var i = 0; i < rules.length; i++) {
    var r = rules[i], m = true;
    if (r.os) {
      if (r.os.name && r.os.name != "windows") m = false;
      if (r.os.arch && r.os.arch != archKey) m = false;
    }
    if (r.features) m = false;
    if (m) ok = (r.action == "allow");
  }
  return ok;
}
function subst(s, vars) {
  return String(s).replace(/\$\{([^}]+)\}/g, function (all, k) { return vars[k] !== undefined ? vars[k] : ""; });
}
function collectArgs(arr, vars, out) {
  for (var i = 0; i < arr.length; i++) {
    var a = arr[i];
    if (typeof a == "string") { out.push(subst(a, vars)); continue; }
    if (!rulesOk(a.rules)) continue;
    var v = a.value;
    if (typeof v == "string") out.push(subst(v, vars));
    else for (var j = 0; j < v.length; j++) out.push(subst(v[j], vars));
  }
}
var pendingServer = "";
function buildLaunchArgs(ver, vars, extra) {
  var ram = parseInt((typeof cfg == "object" && cfg.ram) ? cfg.ram : 2, 10);
  if (!(ram >= 1 && ram <= 32)) ram = 2;
  var out = ["-Xmx" + ram + "G", "-Xms512M"];
  var jvm = [], hasCp = false, i;
  collectArgs(ver.arguments.jvm || [], vars, jvm);
  for (i = 0; i < jvm.length; i++) if (jvm[i] == "-cp" || jvm[i] == "-classpath") hasCp = true;
  if (!hasCp) { jvm.push("-cp"); jvm.push(vars.classpath); }
  out = out.concat(jvm);
  if (typeof cfg == "object" && cfg.fpsBoost !== false) {
    out = out.concat(["-XX:+UseG1GC","-XX:+UnlockExperimentalVMOptions","-XX:G1NewSizePercent=30","-XX:G1MaxNewSizePercent=40","-XX:G1HeapRegionSize=8M","-XX:G1ReservePercent=20","-XX:MaxGCPauseMillis=50","-XX:+DisableExplicitGC","-XX:+AlwaysPreTouch","-XX:+ParallelRefProcEnabled"]);
  }
  if (extra && extra.jvm) out = out.concat(extra.jvm);
  out.push(ver.mainClass);
  collectArgs(ver.arguments.game || [], vars, out);
  if (pendingServer && /^1\.(2\d|[3-9]\d)/.test(String(vars.version_name).replace(/^fabric-loader-[^-]+-/, ""))) { out.push("--quickPlayMultiplayer"); out.push(pendingServer); }
  if (typeof cfg == "object") {
    if (cfg.fullscreen) out.push("--fullscreen");
    else if (cfg.size && cfg.size != "default") {
      var wh = String(cfg.size).split("x");
      if (wh.length == 2) { out.push("--width"); out.push(wh[0]); out.push("--height"); out.push(wh[1]); }
    }
  }
  return out;
}

// ---------- progress UI ----------
function showProg(on, text, pct) {
  $("prog").style.display = on ? "block" : "none";
  if (text !== undefined) $("progtext").innerText = text;
  if (pct !== undefined) $("pfill").style.width = Math.max(0, Math.min(100, pct)) + "%";
}
function fail(msg) {
  busy = false;
  showProg(false);
  $("playbtn").disabled = false; $("herobtn").disabled = false;
  log("ERROR: " + msg);
  setStatus(msg, true);
}

// ---------- Minicraft menu theme (a resource pack the launcher writes into .minecraft\resourcepacks) ----------
var PACK_VER = 4;
var PACK_FILES = {"assets/minecraft/textures/gui/sprites/widget/button.png": ["b64", "iVBORw0KGgoAAAANSUhEUgAAAMgAAAAUCAYAAADIpHLKAAAAdUlEQVR42u3boQ2AMABE0StbsEkligEYlAGqkGzCGCBIBSFozHsjXPLllSSZ5+UM8NDaWkqPY9+3wyRwq3Uak2QQB7z1JgZTwDeBgEBAICAQEAgIBAQCAgGBgEAAgYBAQCAgEPg1kH4OAfI4TJXE5Rbycbm9AOwEFgPRo7/kAAAAAElFTkSuQmCC"], "assets/minecraft/textures/gui/sprites/widget/button.png.mcmeta": ["txt", "{\"gui\": {\"scaling\": {\"type\": \"nine_slice\", \"width\": 200, \"height\": 20, \"border\": 3}}}"], "assets/minecraft/textures/gui/sprites/widget/button_highlighted.png": ["b64", "iVBORw0KGgoAAAANSUhEUgAAAMgAAAAUCAYAAADIpHLKAAAAdUlEQVR42u3bMQ2AMABE0SsGmKoBHYhAJSLQgYZOKICBdCCEmeU9CZf88UqStNbOAA+11lJ6HMs0HyaB27pvY5IM4oC33sRgCvgmEBAICAQEAgIBgYBAQCAgEBAIIBAQCAgEBAK/BtLPIUAeh6mSuNxCPi63F1QlF+ZwVaH6AAAAAElFTkSuQmCC"], "assets/minecraft/textures/gui/sprites/widget/button_highlighted.png.mcmeta": ["txt", "{\"gui\": {\"scaling\": {\"type\": \"nine_slice\", \"width\": 200, \"height\": 20, \"border\": 3}}}"], "assets/minecraft/textures/gui/sprites/widget/button_disabled.png": ["b64", "iVBORw0KGgoAAAANSUhEUgAAAMgAAAAUCAYAAADIpHLKAAAAdElEQVR42u3bIQqAQABE0VlPYzLYhM0e2izYDCaPY5ANImbLe0cY+HFKktQ6HwEe1nUZSotj37fTJHAbx6lPkk4c8Naa6EwB3wQCAgGBgEBAICAQEAgIBAQCAgEEAgIBgYBA4NdA2jkEyOMwVRKXW8jH5fYCyqUVtnIGB9oAAAAASUVORK5CYII="], "assets/minecraft/textures/gui/sprites/widget/button_disabled.png.mcmeta": ["txt", "{\"gui\": {\"scaling\": {\"type\": \"nine_slice\", \"width\": 200, \"height\": 20, \"border\": 3}}}"], "assets/minecraft/textures/gui/title/minecraft.png": ["b64", ""], "assets/minecraft/textures/gui/title/edition.png": ["b64", "iVBORw0KGgoAAAANSUhEUgAAAIAAAAAQCAYAAADeWHeIAAAAHklEQVR42u3BAQ0AAADCoPdPbQ8HFAAAAAAAAADwZiAQAAGkXsPmAAAAAElFTkSuQmCC"], "PANORAMA": ["b64", ""], "pack.mcmeta": ["txt", "{\"pack\": {\"pack_format\": 64, \"supported_formats\": {\"min_inclusive\": 46, \"max_inclusive\": 99}, \"description\": \"Minicraft black and white menu theme\"}}"]};
function packDir() { return gameDir + "\\resourcepacks\\Minicraft"; }
function installPack() {
  try {
    var dir = packDir(), verFile = dir + "\\pack.ver";
    if (fso.FileExists(verFile) && fso.FileExists(dir + "\\pack.mcmeta") && readRaw(verFile).indexOf("v" + PACK_VER) == 0) return true;
    mkdirs(gameDir + "\\resourcepacks"); mkdirs(dir); mkdirs(cfgDir);
    var cmd = [], k, i;
    for (k in PACK_FILES) {
      var kind = PACK_FILES[k][0], data = PACK_FILES[k][1];
      var targets = (k == "PANORAMA") ? [] : [k];
      if (k == "PANORAMA") for (i = 0; i < 6; i++) targets.push("assets/minecraft/textures/gui/title/background/panorama_" + i + ".png");
      for (i = 0; i < targets.length; i++) {
        var rel = targets[i].replace(/\//g, "\\"), dest = dir + "\\" + rel;
        mkdirs(fso.GetParentFolderName(dest));
        if (kind == "txt") { var tf = fso.CreateTextFile(dest, true, false); tf.Write(data); tf.Close(); }
        else {
          var b64 = cfgDir + "\\pk_" + cmd.length + ".b64";
          var bf = fso.CreateTextFile(b64, true, false); bf.Write(data); bf.Close();
          cmd.push('certutil -f -decode "' + b64 + '" "' + dest + '" >nul 2>&1');
        }
      }
    }
    for (i = 0; i < cmd.length; i += 6) sh.Run('cmd /c ' + cmd.slice(i, i + 6).join(" & "), 0, true);
    for (i = 0; i < cmd.length; i++) { try { fso.DeleteFile(cfgDir + "\\pk_" + i + ".b64"); } catch (e1) {} }
    var vf = fso.CreateTextFile(verFile, true, false); vf.Write("v" + PACK_VER); vf.Close();
    log("Installed the Minicraft menu theme (resource pack).");
    return true;
  } catch (e) { log("Could not install the menu theme: " + e.message); return false; }
}
// Turns the pack on or off in options.txt (adds or removes "file/Minicraft" in the resourcePacks list).
function setPackEnabled(on) {
  try {
    var op = gameDir + "\\options.txt", text = fso.FileExists(op) ? readRaw(op) : "";
    var m = text.match(/^resourcePacks:(.*)$/m), list = [];
    if (m) { try { list = JSON.parse(m[1].replace(/\r/g, "")); } catch (e0) { list = ["vanilla"]; } }
    else list = ["vanilla"];
    var has = false, out = [], i;
    for (i = 0; i < list.length; i++) { if (list[i] == "file/Minicraft") has = true; else out.push(list[i]); }
    if (on) out.push("file/Minicraft");
    else if (!has) return;
    if (on && has) return;
    var line = "resourcePacks:" + JSON.stringify(out);
    text = m ? text.replace(/^resourcePacks:.*$/m, line) : (text.length && !/\n$/.test(text) ? text + "\r\n" : text) + line + "\r\n";
    var f = fso.CreateTextFile(op, true, false); f.Write(text); f.Close();
    log(on ? "Turned on the Minicraft menu theme." : "Turned off the Minicraft menu theme.");
  } catch (e) { log("Could not change options.txt: " + e.message); }
}
function applyPack() {
  if (cfgBool("packOn", true)) { if (installPack()) setPackEnabled(true); }
  else setPackEnabled(false);
}
// ---------- thumbnails: Minecraft's own title-screen picture, read from the game the launcher installed on this PC ----------
var thumbBusy = false, thumbTry = {}, skinName = "";
function thumbPath(id) { return cfgDir + "\\thumbs\\" + safeKey(id) + ".png"; }
function fileUrl(p) { return "file:///" + p.replace(/\\/g, "/").replace(/ /g, "%20"); }
function makeThumb(id, dest) {
  try {
    var jar = gameDir + "\\versions\\" + id + "\\" + id + ".jar";
    if (!fso.FileExists(jar)) return;
    var dir = cfgDir + "\\thumbs", out = dir + "\\_out", tmp = dir + "\\_tmp.zip";
    mkdirs(dir); mkdirs(out);
    fso.CopyFile(jar, tmp, true);
    if (!shellApp) shellApp = new ActiveXObject("Shell.Application");
    var z = shellApp.NameSpace(tmp);
    if (z) {
      var f = zipExtract(z, "assets/minecraft/textures/gui/title/background/panorama_0.png", out);
      if (f) fso.CopyFile(f, dest, true);
    }
    try { fso.DeleteFile(tmp); } catch (e1) {}
  } catch (e) { log("Could not make a thumbnail for " + id + ": " + e.message); }
}
function useThumb(el, id) {
  try {
    var p = thumbPath(id);
    if (!fso.FileExists(p)) return;
    el.style.backgroundImage = "url(" + fileUrl(p) + ")";
    el.style.backgroundSize = "cover";
    el.style.backgroundPosition = "center";
  } catch (e) {}
}
function fillThumbs() {
  if (thumbBusy) return;
  thumbBusy = true;
  var list = [], kids = $("vgrid").childNodes, i;
  for (i = 0; i < kids.length; i++) list.push(kids[i]);
  var idx = 0;
  (function next() {
    if (idx >= list.length) { thumbBusy = false; return; }
    var el = list[idx++], id = el.getAttribute("data-v");
    try {
      var p = thumbPath(id);
      if (!fso.FileExists(p) && !thumbTry[id]) { thumbTry[id] = 1; makeThumb(id, p); }
      useThumb(el, id);
    } catch (e) {}
    setTimeout(next, 30);
  })();
  setTimeout(function () { thumbBusy = false; }, 15000);
}
// ---------- home page: hero + news + promo banner (news.json on GitHub, so you can edit it without an update) ----------
var NEWS_URL = "https://raw.githubusercontent.com/" + MINI_REPO + "/main/news.json";
var promoUrl = "";
var DEFAULT_NEWS = {
  promo: { badge: "NEW", title: "Minicraft", text: "Your launcher, your menus, your cape.", button: "Open", url: "" },
  news: [
    { tag: "Update", title: "New Minecraft menus", text: "The title screen and the ESC menu have a new look in game on 1.21.7." },
    { tag: "Mods", title: "Build your own HUD", text: "Press Esc in game, click Mini Client and pick what shows on the bar." },
    { tag: "Cosmetics", title: "Capes", text: "Add your own cape PNG in Settings. Only you can see it." }
  ]
};
function esc(t) { return String(t).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
function renderNews(data) {
  var box = $("hnews"), i, n = data.news || [], html = "";
  for (i = 0; i < n.length && i < 2; i++)
    html += '<div class="ncard"><span class="vt hot">' + esc(n[i].tag || "News") + '</span><div class="ntitle">' + esc(n[i].title || "") + '</div><div class="ntext">' + esc(n[i].text || "") + '</div></div>';
  box.innerHTML = html;
  var p = data.promo || {};
  $("promobadge").innerText = p.badge || "NEW";
  $("promotitle").innerText = p.title || "";
  $("promodesc").innerText = p.text || "";
  $("promobtn").innerText = p.button || "Open";
  promoUrl = (p.url && /^https:\/\//i.test(p.url)) ? p.url : "";
  $("promobtn").style.display = promoUrl ? "inline-block" : "none";
}
function loadNews() {
  renderNews(DEFAULT_NEWS);
  try { renderNews(getJson(NEWS_URL)); } catch (e) { log("Could not load the news: " + e.message); }
}
function openPromo() { if (promoUrl) { try { sh.Run('"' + promoUrl + '"', 1, false); } catch (e) {} } }
function renderHomeServers() {
  var l = getServers(), h = "", i;
  for (i = 0; i < l.length && i < 6; i++)
    h += '<div class="hs" onclick="joinServer(' + i + ')"><img src="https://api.mcsrvstat.us/icon/' + encodeURIComponent(l[i][1]) + '" /><i>JOIN</i><b>' + esc(l[i][0]) + '</b><span>' + esc(l[i][1]) + '</span></div>';
  $("hsrvlist").innerHTML = h;
  var q = "";
  for (i = 0; i < l.length && i < 9; i++) q += '<img class="qpi" title="' + esc(l[i][0]) + '" onclick="joinServer(' + i + ')" src="https://api.mcsrvstat.us/icon/' + encodeURIComponent(l[i][1]) + '" />';
  $("qplist").innerHTML = q;
}
function renderHome() {
  try {
    var v = $("versions").value || "", name = $("who").innerText;
    $("herotitle").innerText = v ? "Minecraft " + v : "Minecraft";
    $("hname").innerText = (name && name != "No account") ? "signed in as " + name : "not signed in";
    $("herodesc").innerText = v ? (miniFor(v) ? "Mini Client with your settings. One click and you are in game." : "Your last version is ready. One click and you are in game.") : "Loading your versions...";
    $("wname").innerText = (name && name != "No account") ? name : "player";
    $("herobtn").innerHTML = "LAUNCH " + (v || "") + '<span id="herorty">READY TO LAUNCH</span>';
    try { var an = (name && name != "No account") ? name : ""; if (an) $("acctimg").src = "https://mc-heads.net/avatar/" + encodeURIComponent(an) + "/34"; } catch (e1) {}
    renderHomeServers();
    var hero = $("hero");
    hero.style.backgroundImage = "url(" + BG_DATA + ")";
    hero.style.backgroundRepeat = "no-repeat";
    hero.style.backgroundSize = "cover";
    hero.style.backgroundPosition = "50% 35%";
    useThumb(hero, v);
  } catch (e) {}
}

// ---------- version cards + selected-version panel ----------
var CARD_POS = ["0% 0%", "100% 0%", "0% 100%", "100% 100%", "50% 20%", "30% 80%", "80% 40%"];
function isModVer(id) { return /^1\.21(\.\d+)?$/.test(id); }
function artStyle(i, w) {
  return "background-image:url(" + BG_DATA + ");background-repeat:no-repeat;background-size:" + w + "% auto;background-position:" + CARD_POS[i % CARD_POS.length] + ";";
}
var vtab = "all";
function setVTab(t) {
  vtab = t;
  var a = ["all", "fab", "van"];
  for (var i = 0; i < a.length; i++) $("vt_" + a[i]).className = (a[i] == t) ? "vtab on" : "vtab";
  renderCards();
}
function renderCards() {
  try {
    var sel = $("versions"), box = $("vgrid"), cur = sel.value, ids = [], i, k;
    box.innerHTML = "";
    var opts = {}; for (i = 0; i < sel.options.length; i++) opts[sel.options[i].text] = 1;
    function add(id) { if (!id || !opts[id]) return; for (var j = 0; j < ids.length; j++) if (ids[j] == id) return; ids.push(id); }
    if (cur) add(cur);
    if (sel.options.length) add(sel.options[0].text);
    var pref = ["1.21.11", "1.21.7", "1.21.4", "1.21.1", "1.20.1", "1.19.4"];
    for (k = 0; k < pref.length; k++) add(pref[k]);
    for (i = 0; i < sel.options.length && ids.length < 12; i++) if (/^\d+\.\d+(\.\d+)?$/.test(sel.options[i].text)) add(sel.options[i].text);
    var q = ($("vsearch").value || "").toLowerCase(), keep = [];
    for (i = 0; i < ids.length; i++) {
      if (vtab == "fab" && !isModVer(ids[i])) continue;
      if (vtab == "van" && isModVer(ids[i])) continue;
      if (q && ids[i].toLowerCase().indexOf(q) < 0) continue;
      keep.push(ids[i]);
    }
    ids = keep;
    for (i = 0; i < ids.length; i++) {
      var d = document.createElement("div");
      d.className = "vc" + (ids[i] == cur ? " on" : "");
      d.style.cssText = artStyle(i, 260 + (i % 3) * 40);
      d.setAttribute("data-v", ids[i]);
      d.onclick = (function (id) { return function () { pickVersion(id); }; })(ids[i]);
      d.innerHTML = '<div class="vtag">' + (isModVer(ids[i]) ? "Mods" : "Vanilla") + '</div><div class="vband"></div><div class="vname">' + ids[i] + '</div><div class="vsub">' + (isModVer(ids[i]) ? "Mods ready" : "Plain game") + '</div>';
      box.appendChild(d);
    }
    setTimeout(fillThumbs, 60);
  } catch (e) { log("Could not draw version cards: " + e.message); }
}
function renderSelected() {
  try {
    var v = $("versions").value || "", tags = "", desc;
    $("vtitle").innerText = v ? "Minecraft " + v : "Minecraft";
    $("vart").style.cssText = artStyle(3, 300);
    useThumb($("vart"), v);
    var sk = $("vskin");
    if (skinName) { var u = "https://mc-heads.net/body/" + encodeURIComponent(skinName) + "/160"; if (sk.getAttribute("data-u") != u) { sk.setAttribute("data-u", u); sk.src = u; } sk.style.display = "block"; }
    else sk.style.display = "none";
    var mod = isModVer(v);
    tags += '<span class="vt hot">' + (mod ? "Mods" : "Vanilla") + '</span>';
    if (mod && cfgBool("builtinOn", true)) tags += '<span class="vt">Mini Client</span>';
    if (cfgBool("capeOn", true) && CAPE_VERSIONS.indexOf("," + v + ",") >= 0) tags += '<span class="vt">Capes</span>';
    $("vtags").innerHTML = tags;
    if (mod) desc = cfgBool("builtinOn", true) ? (miniFor(v) ? "Fabric with the Mini Client mod. In game, press Esc and click Mini Client to change the FPS and CPS bar and the menu style." : "Fabric with your built-in mods. In game, press Right Shift to move the FPS and CPS counters.") : "Built-in mods are off. Turn them on in Settings to get FPS and CPS counters.";
    else desc = "Plain Minecraft. The built-in mods need a 1.21 version.";
    $("vdesc").innerText = desc;
    $("vram").innerText = (cfg.ram || "2") + " GB";
    $("sver").innerText = "v" + APP_VERSION;
    renderHome();
  } catch (e) {}
}
// ---------- servers ----------
var DEFAULT_SERVERS = [["Hypixel","mc.hypixel.net"],["Wynncraft","play.wynncraft.com"],["CubeCraft","play.cubecraft.net"],["2b2t","2b2t.org"],["Minemen Club","minemen.club"]];
function getServers() { if (!cfg.servers) cfg.servers = DEFAULT_SERVERS; return cfg.servers; }
function esc2(t) { return String(t).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;"); }
function renderServers() {
  var l = getServers(), h = "", i;
  for (i = 0; i < l.length; i++) {
    h += '<div class="card svrow"><img class="svico" src="https://api.mcsrvstat.us/icon/' + encodeURIComponent(l[i][1]) + '" width="48" height="48" /><div class="svtxt"><b>' + esc2(l[i][0]) + '</b><span>' + esc2(l[i][1]) + '</span></div>' +
      '<button class="btn small" onclick="removeServer(' + i + ')">Remove</button> <button class="btn small" id="svjoin' + i + '" onclick="joinServer(' + i + ')">JOIN</button></div>';
  }
  $("svlist").innerHTML = h;
}
function joinServer(i) {
  var s = getServers()[i]; if (!s) return;
  pendingServer = s[1]; setStatus("Joining " + s[0] + " after launch...", false); play();
}
function addServer() {
  var n = $("sv_name").value.replace(/^\s+|\s+$/g, ""), ip = $("sv_ip").value.replace(/^\s+|\s+$/g, "");
  if (!/^[A-Za-z0-9.\-]+(:\d+)?$/.test(ip)) { setStatus("That server address does not look right.", true); return; }
  getServers().push([n || ip, ip]); saveCfg(); $("sv_name").value = ""; $("sv_ip").value = ""; renderServers();
}
function removeServer(i) { getServers().splice(i, 1); saveCfg(); renderServers(); }
function pickVersion(id) {
  try {
    var sel = $("versions");
    for (var i = 0; i < sel.options.length; i++) if (sel.options[i].text == id) sel.selectedIndex = i;
    cfg.version = id;
    updateModWarn();
    renderCards();
  } catch (e) {}
}

// ---------- version list ----------
function loadVersions() {
  try {
    var m = getJson(VERSIONS_URL);
    versionList = m.versions;
    var sel = $("versions");
    sel.options.length = 0;
    var n = 0, want = 0;
    for (var i = 0; i < versionList.length && n < 45; i++) {
      if (versionList[i].type != "release") continue;
      var o = document.createElement("option");
      o.text = versionList[i].id;
      sel.options.add(o);
      if (versionList[i].id == cfg.version) want = n;
      n++;
    }
    sel.selectedIndex = want;
    if (useFabric() && !modVersionOk(sel.value)) preferModVersion();
    updateModWarn();
    renderCards();
  } catch (e) {
    log("Could not load version list: " + e.message);
    setStatus("Could not load the Minecraft version list. Check your internet.", true);
  }
}

// ---------- Play ----------
function ensureLogin() {
  var now = new Date().getTime();
  if (mcToken && now - mcTime < 20 * 3600 * 1000) return;
  mcToken = "";
  trySilentLogin();
}
var lastLaunch = 0;
function play() {
  log("Play pressed. Signed in: " + (mcToken ? "yes" : "not yet") + ", version: " + $("versions").value);
  setStatus("Starting...");
  if (busy) { log("Already working on a launch."); return; }
  if (lastLaunch && (new Date().getTime() - lastLaunch) < 45000) { setStatus("Minecraft is still starting. Wait for the window to open.", true); log("Ignored a second Play press while Minecraft was starting."); return; }
  busy = true;
  $("playbtn").disabled = true; $("herobtn").disabled = true;
  tPlay = new Date().getTime();
  setStatus("Starting Minecraft...");
  showProg(true, "Starting...", 5);
  setTimeout(playGo, 40);   // let the window repaint before the heavy work starts
}
function elapsed() { return ((new Date().getTime() - tPlay) / 1000).toFixed(1) + "s"; }
function playGo() {
  try {
    ensureLogin();
    log("Login ready after " + elapsed());
    if (!mcToken) {
      fail("Sign in with Microsoft first (Account tab), then press Play.");
      show("account");
      return;
    }
    var id = $("versions").value;
    if (!id) { fail("Pick a Minecraft version first."); return; }
    cfg.version = id; saveCfg();
    startPrepare(id);
  } catch (e) { fail("Play failed: " + e.message); }
}
function startPrepare(id) {
  try {
    var fc = fastLoad(id);
    if (fc) {
      log("Fast start: " + id + " is already set up, skipping file checks.");
      ctx = fc;
      setStatus("Starting Minecraft " + id + "...");
      launchGame();
      return;
    }
    showProg(true, "Reading version info...", 0);
    setStatus("Preparing Minecraft " + id + "...");
    var vi = null, i;
    for (i = 0; versionList && i < versionList.length; i++) if (versionList[i].id == id) vi = versionList[i];
    if (!vi) { fail("Version list is not loaded. Check your internet and reopen the client."); return; }
    var ver = getJson(vi.url);
    if (!ver.arguments || !ver.downloads || !ver.downloads.client) {
      fail("Version " + id + " is too old for this launcher. Pick a newer one (1.19 or later).");
      return;
    }
    var q = [], cp = [], vanillaKeys = [];

    for (i = 0; i < ver.libraries.length; i++) {
      var lib = ver.libraries[i];
      if (lib.natives && lib.natives.windows && rulesOk(lib.rules)) {
        fail("Version " + id + " is too old for this launcher. Pick a newer one (1.19 or later).");
        return;
      }
      if (!rulesOk(lib.rules)) continue;
      var art = lib.downloads && lib.downloads.artifact;
      if (!art) continue;
      var lp = gameDir + "\\libraries\\" + art.path.replace(/\//g, "\\");
      q.push({ url: art.url, path: lp, size: art.size });
      cp.push(lp);
      vanillaKeys.push({ key: libKey(lib.name), path: lp });
    }

    // ----- built-in mods: Fabric loader + mods from Modrinth (only applied if everything is available) -----
    var addMods = [], modsNote = "", modsFailed = false, skipped = [];
    if (useFabric()) {
      try {
        showProg(true, "Setting up mods...", 0);
        var fabList = getJson("https://meta.fabricmc.net/v2/versions/loader/" + id);
        var loaderV = "";
        for (i = 0; i < fabList.length; i++) if (fabList[i].loader && fabList[i].loader.stable) { loaderV = fabList[i].loader.version; break; }
        if (!loaderV) throw new Error("Fabric does not support " + id + " yet");
        var prof = getJson("https://meta.fabricmc.net/v2/versions/loader/" + id + "/" + loaderV + "/profile/json");
        var modFiles = [], wm = wantedMods(id), mi;
        for (mi = 0; mi < wm.length; mi++) {
          var mf = (wm[mi].slug == "@mini") ? miniModFile() : modrinthFile(wm[mi].slug, id);
          if (mf) modFiles.push(mf);
          else { skipped.push(wm[mi].label); log(wm[mi].label + " is not available for " + id + ", skipping it."); }
        }
        // everything was fetched, now apply it
        ver.mainClass = prof.mainClass;
        if (prof.arguments) {
          if (prof.arguments.jvm) ver.arguments.jvm = ver.arguments.jvm.concat(prof.arguments.jvm);
          if (prof.arguments.game) ver.arguments.game = ver.arguments.game.concat(prof.arguments.game);
        }
        // Fabric brings its own version of some libraries (e.g. ASM). Drop Minecraft's copy so only one is on the classpath.
        var fabKeys = {};
        for (mi = 0; mi < prof.libraries.length; mi++) fabKeys[libKey(prof.libraries[mi].name)] = 1;
        for (mi = 0; mi < vanillaKeys.length; mi++) {
          if (!fabKeys[vanillaKeys[mi].key]) continue;
          var vp = vanillaKeys[mi].path, xi;
          for (xi = cp.length - 1; xi >= 0; xi--) if (cp[xi] == vp) cp.splice(xi, 1);
          for (xi = q.length - 1; xi >= 0; xi--) if (q[xi].path == vp) q.splice(xi, 1);
          log("Using Fabric's version of " + vanillaKeys[mi].key + " instead of Minecraft's.");
        }
        for (mi = 0; mi < prof.libraries.length; mi++) {
          var fl = prof.libraries[mi], rel = mavenPath(fl.name);
          var flp = gameDir + "\\libraries\\" + rel.replace(/\//g, "\\");
          q.push({ url: (fl.url || "https://maven.fabricmc.net/") + rel, path: flp, size: 0 });
          cp.push(flp);
        }
        var mdir = cfgDir + "\\builtin_mods\\" + id;
        for (mi = 0; mi < modFiles.length; mi++) {
          var mp = mdir + "\\" + modFiles[mi].name;
          q.push({ url: modFiles[mi].url, path: mp, size: modFiles[mi].size });
          addMods.push(mp);
        }
        log("Mods: Fabric loader " + loaderV + " with " + modFiles.length + " built-in mod(s).");
      } catch (fe) {
        addMods = [];
        modsFailed = true;
        modsNote = fe.message;
        log("Mods are not available for " + id + " (" + fe.message + "). Starting plain Minecraft.");
      }
    }

    var jar = gameDir + "\\versions\\" + id + "\\" + id + ".jar";
    q.push({ url: ver.downloads.client.url, path: jar, size: ver.downloads.client.size });
    cp.push(jar);

    var ai = ver.assetIndex;
    q.push({ url: ai.url, path: gameDir + "\\assets\\indexes\\" + ai.id + ".json", size: ai.size });
    var idx = getJson(ai.url), seen = {};
    for (var nm in idx.objects) {
      var o = idx.objects[nm];
      if (seen[o.hash]) continue;
      seen[o.hash] = 1;
      var pre = o.hash.substring(0, 2);
      q.push({ url: "https://resources.download.minecraft.net/" + pre + "/" + o.hash,
               path: gameDir + "\\assets\\objects\\" + pre + "\\" + o.hash, size: o.size });
    }

    var comp = ver.javaVersion ? ver.javaVersion.component : "jre-legacy";
    // Reuse the official launcher's Java if it is there; otherwise keep our own copy.
    var offRt = mcDir + "\\runtime\\" + comp + "\\" + rtPlatform + "\\" + comp;
    var rtDir, rtNew;
    if (fso.FileExists(offRt + "\\bin\\java.exe")) { rtDir = offRt; rtNew = false; }
    else { rtDir = cfgDir + "\\runtime\\" + comp; rtNew = !fso.FileExists(rtDir + "\\.ready"); }
    if (rtNew) {
      showProg(true, "Reading Java runtime info...", 0);
      var all = getJson(RT_INDEX);
      var lst = all[rtPlatform] && all[rtPlatform][comp];
      if (!lst || !lst.length) { fail("No Java runtime '" + comp + "' available for " + rtPlatform + "."); return; }
      var man = getJson(lst[0].manifest.url);
      for (var fp in man.files) {
        var e = man.files[fp];
        if (e.type == "file" && e.downloads && e.downloads.raw)
          q.push({ url: e.downloads.raw.url, path: rtDir + "\\" + fp.replace(/\//g, "\\"), size: e.downloads.raw.size });
      }
    }

    ctx = { id: id, ver: ver, cp: cp, rtDir: rtDir, rtNew: rtNew, addMods: addMods, modsNote: modsNote, modsFailed: modsFailed, skipped: skipped, queue: q, qi: 0, done: 0 };
    log("Preparing " + id + ": " + q.length + " files to check (Java runtime " + comp + (rtNew ? ", needs download" : ", already installed") + ")");
    pump();
  } catch (e) { fail("Could not prepare the game: " + e.message); }
}
// ---------- fast start ----------
// After one full setup, later launches skip all network calls and the 4,000-file check.
function fastFile(id) { return cfgDir + "\\fast_" + id + "_" + modSig() + ".json"; }
function fastSave() {
  try {
    mkdirs(cfgDir);
    var f = fso.CreateTextFile(fastFile(ctx.id), true, true);   // unicode
    f.Write(JSON.stringify({ id: ctx.id, ver: ctx.ver, cp: ctx.cp, rtDir: ctx.rtDir, addMods: ctx.addMods || [] }));
    f.Close();
  } catch (e) { log("Could not save fast-start info: " + e.message); }
}
function fastLoad(id) {
  try {
    var p = fastFile(id);
    if (!fso.FileExists(p)) return null;
    var f = fso.OpenTextFile(p, 1, false, -1);
    var t = f.AtEndOfStream ? "" : f.ReadAll();
    f.Close();
    var d = JSON.parse(t);
    if (!d || d.id != id || !d.cp || !d.ver) return null;
    if (!fso.FileExists(d.rtDir + "\\bin\\java.exe")) return null;
    for (var i = 0; i < d.cp.length; i++) if (!fso.FileExists(d.cp[i])) return null;
    var am = d.addMods || [];
    for (var m = 0; m < am.length; m++) if (!fso.FileExists(am[m])) return null;
    return { id: id, ver: d.ver, cp: d.cp, rtDir: d.rtDir, addMods: am, rtNew: false, queue: [], qi: 0, done: 0 };
  } catch (e) { return null; }
}
function clearFast() {
  try {
    var en = new Enumerator(fso.GetFolder(cfgDir).Files);
    for (; !en.atEnd(); en.moveNext()) if (/^fast_.*\.json$/i.test(en.item().Name)) fso.DeleteFile(en.item().Path);
    setStatus("Done. The next Play re-checks all game files once (slower), then it is fast again.");
  } catch (er) { setStatus("Could not clear fast-start data: " + er.message, true); }
}
function needed(it) {
  return !(fso.FileExists(it.path) && (!it.size || fso.GetFile(it.path).Size == it.size));
}
function pump() {
  var c = ctx, t0 = new Date().getTime();
  try {
    while (c.qi < c.queue.length && new Date().getTime() - t0 < 400) {
      var it = c.queue[c.qi++];
      if (needed(it)) {
        try { dl(it.url, it.path); }
        catch (e1) { dl(it.url, it.path); }   // one retry
      }
      c.done++;
    }
  } catch (e) { fail("Download failed: " + e.message); return; }
  showProg(true, "Downloading game files: " + c.done + " / " + c.queue.length, c.done * 100 / c.queue.length);
  if (c.qi < c.queue.length) setTimeout(pump, 5);
  else afterDownloads();
}
function afterDownloads() {
  try {
    if (ctx.rtNew) { var f = fso.CreateTextFile(ctx.rtDir + "\\.ready", true); f.Write("ok"); f.Close(); }
    if (!ctx.modsFailed) fastSave();   // never cache a "mods failed" fallback
    launchGame();
  } catch (e) { fail("Could not finish setup: " + e.message); }
}
function launchGame() {
  var c = ctx, ver = c.ver;
  var javaExe = c.rtDir + "\\bin\\java.exe";
  if (!fso.FileExists(javaExe)) { fail("Java was not found at " + javaExe); return; }
  mkdirs(gameDir + "\\versions\\" + c.id + "\\natives");
  var cpf = [];
  for (var i = 0; i < c.cp.length; i++) cpf.push(fwd(c.cp[i]));
  var vars = {
    auth_player_name: mcName, version_name: c.id, game_directory: fwd(gameDir),
    assets_root: fwd(gameDir + "\\assets"), assets_index_name: ver.assetIndex.id,
    auth_uuid: mcUuid, auth_access_token: mcToken, clientid: "0", auth_xuid: "0",
    user_type: "msa", version_type: ver.type || "release",
    natives_directory: fwd(gameDir + "\\versions\\" + c.id + "\\natives"),
    launcher_name: "MiniClient", launcher_version: "1.0", classpath: cpf.join(";")
  };
  if (cfgBool("capeOn", true)) ensureBuiltinCape();
  applyPack();
  applyFpsOptions();
  syncBuiltinMods(c.addMods || []);
  var args = buildLaunchArgs(ver, vars, null);
  pendingServer = "";
  mkdirs(cfgDir);
  try {
    for (var ae = new Enumerator(fso.GetFolder(cfgDir).Files); !ae.atEnd(); ae.moveNext())
      if (/^launch_args.*\.txt$/i.test(ae.item().Name)) { try { fso.DeleteFile(ae.item().Path, true); } catch (e0) {} }
  } catch (e1) {}
  var af = cfgDir + "\\launch_args_" + new Date().getTime() + ".txt";
  var lf = cfgDir + "\\game.log";
  var f = fso.CreateTextFile(af, true, false);
  for (var k = 0; k < args.length; k++)
    f.WriteLine('"' + String(args[k]).replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"');
  f.Close();
  log("Client setup done after " + elapsed() + ". Starting Java now.");
  sh.CurrentDirectory = gameDir;
  log("Java: " + javaExe + " (" + fso.GetFile(javaExe).Size + " bytes). Arguments: " + args.length + ". Game folder: " + gameDir);
  try { var old = fso.OpenTextFile(lf, 2, true); old.Close(); } catch (e) {}   // empty the old game log
  var cmd = 'cmd /c ""' + javaExe + '" @"' + af + '" > "' + lf + '" 2>&1 & if errorlevel 1 echo [java exited with an error code] >> "' + lf + '" & echo [java ended] >> "' + lf + '""';
  sh.Run(cmd, 0, false);
  lastLaunch = new Date().getTime();
  log("Started Minecraft " + c.id + " as " + mcName + ". Game output: " + lf);
  showProg(false);
  busy = false;
  $("playbtn").disabled = false; $("herobtn").disabled = false;
  var nMods = (c.addMods && c.addMods.length) ? c.addMods.length : 0;
  var skip = (c.skipped && c.skipped.length) ? " Skipped (not out for this version): " + c.skipped.join(", ") + "." : "";
  var hints = (cfgBool("builtinOn", true) ? " Right Shift opens the HUD editor." : "") + (cfgBool("capeOn", true) ? " Press Change Cape on the main menu." : "");
  if (nMods) setStatus("Minecraft " + c.id + " is starting with " + nMods + " mods." + hints + skip);
  else if (useFabric()) {
    setStatus("Minecraft " + c.id + " started WITHOUT mods: " + (c.modsNote || "none are available for this version") + ". Try another version.", true);
    log("Started WITHOUT mods. Reason: " + (c.modsNote || "none available for this version"));
  } else setStatus("Minecraft " + c.id + " is starting. The window can take a few seconds to appear.");
  setTimeout(function () { try { fso.DeleteFile(af); } catch (e) {} }, 90000);
  watchWindow(c.id);
  setTimeout(checkLaunch, 9000);
  setTimeout(checkLaunch, 25000);
}
var fabricLogged = false;
function checkLaunch() {
  var lf = cfgDir + "\\game.log";
  try {
    var t = fso.FileExists(lf) ? readRaw(lf) : "";
    if (!fabricLogged && t.length) {
      var ix = t.search(/Loading \d+ mods?/);
      if (ix >= 0) { fabricLogged = true; log("Mods Fabric loaded:\r\n" + t.substring(ix, ix + 900)); }
      else if (/Fabric/i.test(t)) { log("Fabric started but did not list any mods."); }
    }
    var ended = t.indexOf("[java ended]") >= 0;
    var bad = t.indexOf("[java exited with an error code]") >= 0 || /Exception|Could not create|Unrecognized|Error:/.test(t);
    if (bad || (ended && t.length < 60)) {
      log("Game output (last part):\r\n" + (t ? t.substring(Math.max(0, t.length - 1500)) : "(nothing was printed)"));
      setStatus("The game closed straight away. Open the Log tab and send it to Claude.", true);
    } else if (ended) {
      log("The game has closed.");
    } else {
      log("Game is running (no errors so far).");
    }
  } catch (e) { log("Could not read game log: " + e.message); }
}
function checkLaunchOld() {
  var lf = cfgDir + "\\game.log";
  try {
    if (!fso.FileExists(lf)) return;
    var t = readRaw(lf);
    if (/Exception|Error|Could not create|Unrecognized/i.test(t)) {
      log("Game output (last part):\r\n" + t.substring(Math.max(0, t.length - 900)));
      setStatus("The game reported an error. Open the Log tab and send it to Claude.", true);
    }
  } catch (e) {}
}

// ---------- how long until the game window appears ----------
var watchN = 0;
function watchWindow(id) {
  watchN = 0;
  function tick() {
    watchN++;
    var ok = false;
    try { ok = sh.AppActivate("Minecraft* " + id); } catch (e) {}
    if (ok) {
      var s = elapsed();
      log("Minecraft window opened " + s + " after Play was pressed.");
      setStatus("Minecraft " + id + " is running (window opened after " + s + ").");
      return;
    }
    if (watchN < 90) setTimeout(tick, 1000);
  }
  setTimeout(tick, 1000);
}

// ---------- self-update ----------
// The client can replace itself with a newer copy from a web address you set in Settings.
var APP_VERSION = 48;

// ---------- drag the borderless window by its title bar ----------
var dragOn = false, dragDX = 0, dragDY = 0;
function dragStart(e) {
  e = e || window.event;
  dragOn = true;
  dragDX = e.screenX - window.screenLeft;
  dragDY = e.screenY - window.screenTop;
  try { $("titlebar").setCapture(); } catch (er) {}
  return false;
}
var pendingUpdate = null;
function selfPath() {
  var p = decodeURIComponent(location.pathname);
  if (p.charAt(0) == "/") p = p.substring(1);
  return p.replace(/\//g, "\\");
}
function verOf(text) {
  var m = /var APP_VERSION = (\d+);/.exec(text);
  return m ? parseInt(m[1], 10) : 0;
}
var UPDATE_URL = "https://raw.githubusercontent.com/xomaim/miniclient/refs/heads/main/MiniClient.hta";
function checkUpdate(manual) {
  var url = UPDATE_URL;
  try {
    var r = http("GET", url + (url.indexOf("?") < 0 ? "?" : "&") + "t=" + new Date().getTime(), {});
    if (r.status != 200) {
      log("Update check: HTTP " + r.status);
      if (manual) setStatus("Could not check for updates (HTTP " + r.status + "). Is the address right?", true);
      return;
    }
    var v = verOf(r.text);
    if (v > APP_VERSION && r.text.indexOf("<hta:application") >= 0 && /<\/html>\s*$/.test(r.text)) {
      pendingUpdate = r.text;
      $("updtext").innerText = "Update available: v" + v + " (you have v" + APP_VERSION + ")";
      $("updbar").style.display = "inline-block";
      $("updglobal").style.display = "block"; $("updglobaltext").innerText = "Update available: v" + v;
      setStatus("An update is available. Click Update now on the Play page.");
    } else if (manual) {
      setStatus("You are up to date (v" + APP_VERSION + ").");
    }
  } catch (e) {
    log("Update check failed: " + e.message);
    if (manual) setStatus("Could not check for updates: " + e.message, true);
  }
}
function applyUpdate() {
  if (!pendingUpdate) return;
  try {
    if (/[^\x00-\x7F]/.test(pendingUpdate)) { setStatus("This update has characters the updater cannot save. Download the file by hand instead.", true); return; }
    var self = selfPath();
    if (!fso.FileExists(self)) { setStatus("Cannot find this file to update: " + self, true); return; }
    var nw = self + ".new";
    var f = fso.CreateTextFile(nw, true, false);
    f.Write(pendingUpdate); f.Close();
    fso.CopyFile(self, self + ".bak", true);   // keep the old version as a backup
    sh.Run('cmd /c ping -n 4 127.0.0.1 >nul & move /y "' + nw + '" "' + self + '" >nul & start "" "' + self + '"', 0, false);
    setStatus("Updating... the client will restart in a moment.");
    setTimeout(function () { window.close(); }, 300);
  } catch (e) { setStatus("Update failed: " + e.message, true); }
}

// ---------- settings ----------
function cfgBool(k, def) { return (typeof cfg != "object" || cfg[k] === undefined) ? def : !!cfg[k]; }
function applySettingsToUI() {
  $("s_ram").value = String(cfg.ram || "2");
  $("s_size").value = cfg.size || "default";
  $("s_full").checked = cfgBool("fullscreen", false);
  $("s_mods").checked = cfgBool("builtinOn", true);
  $("s_hud").checked = cfgBool("bmHud", true);
  $("s_sodium").checked = cfgBool("bmSodium", true);
  $("s_fps").checked = cfgBool("fpsBoost", true);
  $("s_cape").checked = cfgBool("capeOn", true);
  $("s_pack").checked = cfgBool("packOn", true);
  modsEnabledUI();
  loadCapes();
}
function saveSettings() {
  cfg.ram = $("s_ram").value;
  cfg.size = $("s_size").value;
  cfg.fullscreen = $("s_full").checked;
  cfg.builtinOn = $("s_mods").checked;
  cfg.bmHud = $("s_hud").checked;
  cfg.bmSodium = $("s_sodium").checked;
  cfg.fpsBoost = $("s_fps").checked;
  cfg.capeOn = $("s_cape").checked;
  cfg.packOn = $("s_pack").checked;
  saveCfg();
  modsEnabledUI();
  var msg = "Settings saved.";
  if (useFabric() && !modVersionOk($("versions").value)) {
    if (preferModVersion()) msg = "Settings saved. Switched the version to " + $("versions").value + ", which works with your mods.";
    else msg = "Settings saved. No listed version works with all your mods, so some will be skipped.";
  }
  updateModWarn();
  renderCards();
  setStatus(msg);
}
// Built-in mods only exist for some Minecraft versions.
// HUD+ and Sodium: 1.21 to 1.21.11. Client Capes (per its Modrinth page): the versions listed below.
var CAPE_VERSIONS = ",1.21.7,1.21.5,1.21.4,1.21.1,1.21,1.20.6,1.20.4,1.20.1,";
function useFabric() { return cfgBool("builtinOn", true) || cfgBool("capeOn", true); }
function modVersionOk(v) {
  v = String(v);
  if (cfgBool("builtinOn", true) && !/^1\.21(\.\d+)?$/.test(v)) return false;
  if (cfgBool("capeOn", true) && CAPE_VERSIONS.indexOf("," + v + ",") < 0) return false;
  return true;
}
function preferModVersion() {
  try {
    var sel = $("versions");
    for (var i = 0; i < sel.options.length; i++) {
      if (modVersionOk(sel.options[i].text)) { sel.selectedIndex = i; return true; }
    }
  } catch (e) {}
  return false;
}
function updateModWarn() {
  try {
    var warn = "";
    if (useFabric() && !modVersionOk($("versions").value))
      warn = "Not every mod you turned on works on this version, so some will be skipped.";
    $("modwarn").innerText = warn;
    renderSelected();
  } catch (e) {}
}
function modsEnabledUI() {
  var on = $("s_mods").checked;
  $("s_hud").disabled = !on;
  $("s_sodium").disabled = !on;
  $("modopts").style.opacity = on ? "1" : "0.45";
}
function modSig() {
  if (!useFabric()) return "v";
  var b = cfgBool("builtinOn", true);
  return "m5" + (b && cfgBool("bmHud", true) ? "h" : "") + (b && cfgBool("bmSodium", true) ? "s" : "") + (cfgBool("capeOn", true) ? "c" : "");
}
// Our own in-game mod (built by GitHub from the "mod" folder of the repository). Only made for Minecraft 1.21.7 so far.
var MINI_REPO = "xomaim/miniclient";
function miniFor(id) { return cfgBool("builtinOn", true) && String(id) == "1.21.7"; }
function miniModFile() {
  var url = "https://github.com/" + MINI_REPO + "/releases/download/latest/miniclient-mod.jar", stamp = "latest", size = 0;
  try {
    var r = http("GET", "https://api.github.com/repos/" + MINI_REPO + "/releases/tags/latest", { "User-Agent": "MiniClient-HTA/1.0" });
    if (r.status == 200 && r.json && r.json.assets && r.json.assets.length) {
      var a = r.json.assets[0];
      url = a.browser_download_url; size = a.size || 0;
      stamp = String(a.updated_at || "").replace(/[^0-9]/g, "");
    }
  } catch (e) { log("Could not check the Mini Client mod version: " + e.message); }
  return { url: url, name: "miniclient-mod-" + stamp + ".jar", size: size, version: stamp };
}
function wantedMods(id) {
  var out = [{ slug: "fabric-api", label: "Mini Client" }];
  if (cfgBool("builtinOn", true)) {
    if (miniFor(id)) out.push({ slug: "@mini", label: "Mini Client" });
    else if (cfgBool("bmHud", true)) out.push({ slug: "hud-plus", label: "Mini Client" });
    if (cfgBool("bmSodium", true)) out.push({ slug: "sodium", label: "Mini Client" });
    if (cfgBool("fpsBoost", true)) {
      out.push({ slug: "lithium", label: "Mini Client" });
      out.push({ slug: "ferrite-core", label: "Mini Client" });
      out.push({ slug: "entityculling", label: "Mini Client" });
      out.push({ slug: "immediatelyfast", label: "Mini Client" });
    }
  }
  if (cfgBool("capeOn", true)) out.push({ slug: "client-capes", label: "Mini Client" });
  return out;
}

// ---------- custom cape: your own PNG files in .minecraft\Capes (shown only to you) ----------
var CHERRY_CAPE = "";
function applyFpsOptions() {
  try {
    if (!cfgBool("fpsBoost", true)) return;
    var of = gameDir + "\\options.txt";
    var want = { enableVsync: "false", maxFps: "260", entityShadows: "false", biomeBlendRadius: "1", particles: "2", mipmapLevels: "2", graphicsMode: "0" };
    var lines = [], seen = {}, k;
    if (fso.FileExists(of)) {
      var t = readRaw(of).split(/\r?\n/);
      for (var i = 0; i < t.length; i++) {
        if (!t[i]) continue;
        k = t[i].split(":")[0];
        if (want[k] !== undefined) { lines.push(k + ":" + want[k]); seen[k] = 1; } else lines.push(t[i]);
      }
    }
    for (k in want) if (!seen[k]) lines.push(k + ":" + want[k]);
    var f = fso.CreateTextFile(of, true, false); f.Write(lines.join("\n") + "\n"); f.Close();
  } catch (e) { log("FPS options skipped: " + e.message); }
}
function ensureBuiltinCape() {
  try {
    var dir = gameDir + "\\Capes", dest = dir + "\\Mini Client.png";
    if (fso.FileExists(dest)) return;
    mkdirs(dir); mkdirs(cfgDir);
    var tmp = cfgDir + "\\cape.b64";
    var f = fso.CreateTextFile(tmp, true, false); f.Write(CHERRY_CAPE); f.Close();
    sh.Run('cmd /c certutil -f -decode "' + tmp + '" "' + dest + '" >nul 2>&1', 0, true);
    try { fso.DeleteFile(tmp); } catch (e0) {}
    log(fso.FileExists(dest) ? "Added the built-in cape." : "Could not add the built-in cape.");
  } catch (e) { log("Built-in cape failed: " + e.message); }
}
function loadCapes() {
  ensureBuiltinCape();
  var box = $("capeList");
  box.innerHTML = "";
  var dir = gameDir + "\\Capes", n = 0;
  try {
    if (fso.FolderExists(dir)) {
      for (var en = new Enumerator(fso.GetFolder(dir).Files); !en.atEnd(); en.moveNext()) {
        var f = en.item();
        if (!/\.png$/i.test(f.Name)) continue;
        n++;
        var d = document.createElement("div"); d.className = "capeitem";
        var im = document.createElement("img");
        im.src = "file:///" + encodeURI(fwd(f.Path));
        var nm = document.createElement("div"); nm.className = "capename"; nm.innerText = f.Name.replace(/\.png$/i, "");
        d.appendChild(im); d.appendChild(nm);
        box.appendChild(d);
      }
    }
  } catch (e) { log("Could not list capes: " + e.message); }
  if (!n) {
    var em = document.createElement("div"); em.className = "hint";
    em.innerText = "No capes yet. Click + Add a cape and pick your cape PNG.";
    box.appendChild(em);
  }
}
function addCapeFile() {
  var v = $("capefile").value;
  if (!v) return;
  try {
    var p = String(v).replace(/^"|"$/g, "");
    if (!/\.png$/i.test(p) || !fso.FileExists(p)) { setStatus("Pick a .png cape file.", true); return; }
    var dir = gameDir + "\\Capes";
    mkdirs(dir);
    fso.CopyFile(p, dir + "\\" + fso.GetFileName(p), true);
    log("Added cape: " + dir + "\\" + fso.GetFileName(p));
    loadCapes();
    if (!$("s_cape").checked) { $("s_cape").checked = true; saveSettings(); }
    setStatus("Cape added. In game, press Change Cape on the main menu to pick it. Only you can see it.");
  } catch (e) { setStatus("Could not add the cape: " + e.message, true); }
}
function openCapes() {
  var dir = gameDir + "\\Capes";
  try { mkdirs(dir); sh.Run('explorer.exe "' + dir + '"', 1, false); } catch (e) { setStatus("Could not open the Capes folder: " + e.message, true); }
}

// ---------- Fabric + Modrinth helpers ----------
function libKey(name) { var p = String(name).split(":"); return p[0] + ":" + p[1]; }
function mavenPath(name) {
  var p = String(name).split(":");
  var cl = p[3] ? "-" + p[3] : "";
  return p[0].replace(/\./g, "/") + "/" + p[1] + "/" + p[2] + "/" + p[1] + "-" + p[2] + cl + ".jar";
}
function modrinthFile(slug, mc) {
  var url = "https://api.modrinth.com/v2/project/" + slug + "/version?loaders=" +
            encodeURIComponent('["fabric"]') + "&game_versions=" + encodeURIComponent('["' + mc + '"]');
  var r = http("GET", url, { "User-Agent": "MiniClient-HTA/1.0 (personal launcher)" });
  if (r.status != 200 || !r.json || !r.json.length) return null;
  var v = r.json[0], i;
  for (i = 0; i < r.json.length; i++) if (r.json[i].version_type == "release") { v = r.json[i]; break; }
  if (!v.files || !v.files.length) return null;
  var f = v.files[0];
  for (i = 0; i < v.files.length; i++) if (v.files[i].primary) f = v.files[i];
  return { url: f.url, name: f.filename, size: f.size, version: v.version_number };
}

// ---------- Mods tab: logo + name for every mod file ----------
var shellApp = null, modRows = [], modQi = 0;
function safeKey(s) { return String(s).replace(/[^A-Za-z0-9_.-]/g, "_"); }
function prettyName(file) { return String(file).replace(/^minicraft-/i, "").replace(/\.jar(\.disabled)?$/i, "").replace(/[-_+]+/g, " "); }

// Built-in mods are copied into the mods folder with a "minicraft-" prefix, so Fabric loads them
// the normal way. Old copies are removed first, so switching versions never leaves stale mods behind.
function syncBuiltinMods(list) {
  try {
    var md = gameDir + "\\mods";
    mkdirs(md);
    var want = {}, i, j;
    for (j = 0; j < list.length; j++) want[("minicraft-" + fso.GetFileName(list[j])).toLowerCase()] = list[j];
    var old = [];
    for (var en = new Enumerator(fso.GetFolder(md).Files); !en.atEnd(); en.moveNext())
      if (/^minicraft-.*\.jar$/i.test(en.item().Name) && !want[en.item().Name.toLowerCase()]) old.push(en.item().Path);
    for (i = 0; i < old.length; i++) { try { fso.DeleteFile(old[i], true); } catch (e0) { log("Could not remove old mod " + old[i] + ": " + e0.message); } }
    for (j = 0; j < list.length; j++) {
      var dest = md + "\\minicraft-" + fso.GetFileName(list[j]);
      if (fso.FileExists(dest) && fso.GetFile(dest).Size == fso.GetFile(list[j]).Size) continue;   // already there, leave it alone
      fso.CopyFile(list[j], dest, true);
    }
    log("Built-in mods in the mods folder: " + list.length);
  } catch (e2) { log("Could not copy built-in mods: " + e2.message); }
}
function addModFile() {
  var v = $("modfile").value;
  if (!v) return;
  try {
    var p = String(v).replace(/^"|"$/g, "");
    if (!/\.jar$/i.test(p) || !fso.FileExists(p)) { setStatus("Pick a .jar mod file.", true); return; }
    var md = gameDir + "\\mods";
    mkdirs(md);
    var dest = md + "\\" + fso.GetFileName(p);
    var existed = fso.FileExists(dest);
    fso.CopyFile(p, dest, true);
    setStatus((existed ? "Replaced " : "Added ") + fso.GetFileName(p) + ". It loads the next time you press Play (mods must be on in Settings).");
    log("Added mod: " + dest);
    loadMods();
  } catch (e) { setStatus("Could not add the mod: " + e.message, true); }
}
function zipExtract(z, rel, outDir) {
  var parts = rel.split("/"), folder = z, it, i;
  for (i = 0; i < parts.length - 1; i++) {
    it = folder.ParseName(parts[i]);
    if (!it || !it.IsFolder) return "";
    folder = it.GetFolder;
  }
  it = folder.ParseName(parts[parts.length - 1]);
  if (!it) return "";
  var dest = outDir + "\\" + parts[parts.length - 1];
  try { if (fso.FileExists(dest)) fso.DeleteFile(dest); } catch (e) {}
  shellApp.NameSpace(outDir).CopyHere(it, 4 | 16 | 1024);
  var t0 = new Date().getTime();
  while (!fso.FileExists(dest) && new Date().getTime() - t0 < 2500) {}
  t0 = new Date().getTime();
  while (fso.FileExists(dest) && fso.GetFile(dest).Size == 0 && new Date().getTime() - t0 < 800) {}
  return fso.FileExists(dest) ? dest : "";
}
function modMeta(jar) {
  var file = fso.GetFileName(jar);
  var dir = cfgDir + "\\modcache";
  mkdirs(dir);
  var key = safeKey(file + "_" + fso.GetFile(jar).Size);
  var mj = dir + "\\" + key + ".json", png = dir + "\\" + key + ".png";
  if (fso.FileExists(mj)) {
    try { var c = JSON.parse(readUtf8(mj)); c.icon = fso.FileExists(png) ? png : ""; return c; } catch (e0) {}
  }
  var meta = { name: prettyName(file), version: "", desc: "", icon: "" };
  var tmp = dir + "\\_tmp.zip", out = dir + "\\_out";
  try {
    fso.CopyFile(jar, tmp, true);
    mkdirs(out);
    if (!shellApp) shellApp = new ActiveXObject("Shell.Application");
    var z = shellApp.NameSpace(tmp);
    if (z) {
      var iconPath = "";
      var fj = zipExtract(z, "fabric.mod.json", out);
      if (fj) {
        var j = JSON.parse(readUtf8(fj));
        if (j.name) meta.name = String(j.name);
        if (j.version && String(j.version).indexOf("${") < 0) meta.version = String(j.version);
        if (j.description) meta.desc = String(j.description);
        if (typeof j.icon == "string") iconPath = j.icon;
        else if (j.icon) {
          var best = -1;
          for (var sz in j.icon) if (parseInt(sz, 10) >= best) { best = parseInt(sz, 10); iconPath = j.icon[sz]; }
        }
      } else {
        var mt = zipExtract(z, "META-INF/mods.toml", out);
        if (mt) {
          var tx = readRaw(mt), m;
          if ((m = /displayName\s*=\s*"([^"]+)"/.exec(tx))) meta.name = m[1];
          if ((m = /\nversion\s*=\s*"([^"$]+)"/.exec(tx))) meta.version = m[1];
          if ((m = /logoFile\s*=\s*"([^"]+)"/.exec(tx))) iconPath = m[1];
        }
      }
      if (iconPath) {
        var ip = zipExtract(z, String(iconPath).replace(/^\//, ""), out);
        if (ip) fso.CopyFile(ip, png, true);
      }
    }
  } catch (e) { log("Could not read " + file + ": " + e.message); }
  try { fso.DeleteFile(tmp); } catch (e1) {}
  try { fso.DeleteFolder(out, true); } catch (e2) {}
  try {
    var w = fso.CreateTextFile(mj, true, false);
    w.Write(JSON.stringify({ name: meta.name, version: meta.version, desc: meta.desc }));
    w.Close();
  } catch (e3) {}
  meta.icon = fso.FileExists(png) ? png : "";
  return meta;
}
function jarsIn(dir, builtin) {
  var out = [];
  if (!fso.FolderExists(dir)) return out;
  for (var e = new Enumerator(fso.GetFolder(dir).Files); !e.atEnd(); e.moveNext()) {
    if (/\.jar$/i.test(e.item().Name)) out.push({ path: e.item().Path, builtin: builtin });
  }
  return out;
}
function loadMods() {
  var vid = "";
  try { vid = $("versions").value; } catch (e) {}
  var items = jarsIn(gameDir + "\\mods", false);
  var own = [];
  for (var k = 0; k < items.length; k++) {
    if (/^minicraft-|fabric-api|sodium|lithium|ferrite|entityculling|immediatelyfast|hud-plus|clientcapes|client-capes|capes/i.test(fso.GetFileName(items[k].path))) continue;
    items[k].builtin = false; own.push(items[k]);
  }
  items = own;
  items.sort(function (a, b) { return (b.builtin ? 1 : 0) - (a.builtin ? 1 : 0); });
  $("modCount").innerText = items.length ? items.length + " mod" + (items.length == 1 ? "" : "s") : "";
  var box = $("modList");
  box.innerHTML = "";
  modRows = []; modQi = 0;
  if (!items.length) {
    var em = document.createElement("div");
    em.className = "empty";
    em.innerText = useFabric()
      ? "No mods yet. The built-in mods download the first time you press Play. You can also drop .jar mods into your mods folder."
      : "Mods are turned off. Turn them on in Settings, or drop .jar mods into your mods folder.";
    box.appendChild(em);
    return;
  }
  for (var i = 0; i < items.length; i++) {
    var row = document.createElement("div"); row.className = "item modrow";
    var tag = document.createElement("span"); tag.className = items[i].builtin ? "mtag built" : "mtag";
    tag.innerText = items[i].builtin ? "Built-in" : "Yours";
    var ic = document.createElement("div"); ic.className = "micon";
    var nm0 = prettyName(fso.GetFileName(items[i].path));
    ic.innerText = nm0.charAt(0).toUpperCase();
    var tx = document.createElement("div"); tx.className = "mtext";
    var nm = document.createElement("div"); nm.className = "iname"; nm.innerText = nm0;
    var ds = document.createElement("div"); ds.className = "mdesc"; ds.innerText = fso.GetFileName(items[i].path);
    tx.appendChild(nm); tx.appendChild(ds);
    row.appendChild(tag); row.appendChild(ic); row.appendChild(tx);
    box.appendChild(row);
    modRows.push({ path: items[i].path, icon: ic, name: nm, desc: ds });
  }
  setTimeout(fillNextMod, 30);
}
function filterMods() {
  var q = $("modsearch").value.toLowerCase(), rows = $("modList").childNodes, i;
  for (i = 0; i < rows.length; i++) {
    var t = (rows[i].innerText || "").toLowerCase();
    rows[i].style.display = (!q || t.indexOf(q) >= 0) ? "" : "none";
  }
}
function fillNextMod() {
  if (modQi >= modRows.length) return;
  var r = modRows[modQi++];
  try {
    var m = modMeta(r.path);
    if (m.name) r.name.innerText = m.name;
    r.desc.innerText = (m.version ? "v" + m.version + "  -  " : "") + (m.desc || fso.GetFileName(r.path));
    if (m.icon) {
      r.icon.innerHTML = "";
      var im = document.createElement("img");
      im.src = "file:///" + encodeURI(fwd(m.icon));
      r.icon.appendChild(im);
    }
  } catch (e) { log("Mod info failed: " + e.message); }
  setTimeout(fillNextMod, 20);
}

// ---------- launch ----------

window.onload = function () {
  window.resizeTo(1000, 680);
  try { window.moveTo(Math.round((screen.availWidth - 1000) / 2), Math.round((screen.availHeight - 680) / 2)); } catch (e) {}
  document.onmousemove = function (e) {
    if (!dragOn) return;
    e = e || window.event;
    window.moveTo(e.screenX - dragDX, e.screenY - dragDY);
  };
  document.onkeydown = function (e) {
    e = e || window.event;
    if (e.keyCode == 119) { toggleCmd(); try { e.returnValue = false; } catch (e1) {} return false; }
  };
  document.onmouseup = function () {
    dragOn = false;
    try { $("titlebar").releaseCapture(); } catch (er) {}
  };
  setTimeout(function () {
    buildScene();
  }, 150);
  loadCfg();
  applySettingsToUI();
  show("home");
  checkAccount();
  setTimeout(loadNews, 1200);
  setTimeout(trySilentLogin, 300);
  setTimeout(function () { if (!verified && !cfg.refreshToken) $("welcome").style.display = "block"; }, 400);
  setTimeout(loadVersions, 900);
  setTimeout(function () { checkUpdate(false); }, 1800);
  setInterval(function () { if (!busy && !pendingUpdate) checkUpdate(false); }, 60000);   // look for a new version every minute
};
window.onresize = function () { try { buildScene(); } catch (e) {} };
</script>
</head>
<body>

  <div id="sky"></div>
  <div id="cmdbox" style="display:none">
    <div id="cmdout"></div>
    <div id="cmdrow"><span id="cmdp">/</span><input type="text" id="cmdin" onkeydown="cmdKey(event)" autocomplete="off" /></div>
  </div>
  <div id="welcome" style="display:none">
    <div id="wart" style="background-image:url(data:image/jpeg;base64,)"></div>
    <div id="wpanel">
      <img id="wlogo" src="data:image/png;base64," width="56" height="56" />
      <span id="wclose" onclick="closeWelcome()">&times;</span>
      <div class="wf"><b>Boosted Frames</b><span>Built-in performance tuning for best-in-class FPS on any hardware.</span></div>
      <div class="wf"><b>Capes &amp; Cosmetics</b><span>Your Mini Client cape is built in and ready in game.</span></div>
      <div class="wf"><b>Countless Mods</b><span>The Mini Client HUD and your own mods in one easy list.</span></div>
      <div class="wf"><b>Multi Version</b><span>Play 1.21.x with mods, plus any other Java version, all from one place.</span></div>
      <button id="wlogin" onclick="closeWelcome(); startLogin()">Login with Microsoft Account</button>
      <button id="wguest" onclick="closeWelcome()">Continue as Guest</button>
      <div id="wfoot">Mini Client</div>
    </div>
  </div>
  <div id="loginov" style="display:none;position:absolute;left:0;top:0;right:0;bottom:0;z-index:50;background:rgba(0,0,0,0.72);">
    <div id="logwin"><div id="logbar">Sign in with Microsoft<span id="logx" onclick="closeLogin()">&times;</span></div><div id="wbhost"></div></div>
  </div>

  <div id="updglobal" style="display:none;position:absolute;right:60px;top:2px;z-index:30;background:#ebebeb;color:#ffffff;border-radius:14px;padding:4px 6px 4px 14px;font-size:12px;font-weight:700;"><span id="updglobaltext"></span> <button class="btn small" style="margin:0 0 0 8px;height:22px;padding:0 12px;" onclick="applyUpdate()">Update now</button></div>

  <div id="titlebar" onmousedown="dragStart(event)">
    Mini Client
    <span id="tbclose" onmousedown="event.cancelBubble=true" onclick="window.close()">&times;</span>
  </div>

  <div id="ui">

    <div id="side">
      <div id="slogo"><img src="data:image/png;base64," /></div>
      <div class="sn on" id="nav_home" onclick="show('home')" title="Launch"><svg viewBox="0 0 24 24"><path d="M12 2c3 2 5 6 5 10l-2 3H9l-2-3c0-4 2-8 5-10z"/><circle cx="12" cy="9" r="1.6"/><path d="M7 13l-3 3v3l4-2M17 13l3 3v3l-4-2"/><path d="M10 18l2 4 2-4"/></svg><span>Home</span></div>
      <div class="sn" id="nav_play" onclick="show('play')" title="Versions"><svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="11" rx="5"/><line x1="7" y1="10.5" x2="7" y2="14.5"/><line x1="5" y1="12.5" x2="9" y2="12.5"/><circle cx="16" cy="11.5" r="0.8"/><circle cx="18.2" cy="13.5" r="0.8"/></svg><span>Versions</span></div>
      <div class="sn" id="nav_servers" onclick="show('servers')" title="Servers"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><line x1="3" y1="12" x2="21" y2="12"/></svg><span>Servers</span></div>
      <div class="sn" id="nav_mods" onclick="show('mods')" title="Mods"><svg viewBox="0 0 24 24"><path d="M9 3h4v3a2 2 0 1 0 4 0V3h3v6h-3a2 2 0 1 0 0 4h3v8H4v-6h3a2 2 0 1 0 0-4H4V3z"/></svg><span>Mods</span></div>
      <div class="sn" id="nav_saves" onclick="show('saves')"><svg viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg><span>Saves</span></div>
      <div class="sn" id="nav_account" onclick="show('account')"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>Account</span></div>
      <div class="sn" id="nav_settings" onclick="show('settings')" title="Settings"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg><span>Settings</span></div>
      <div class="sn" id="nav_log" onclick="show('log')"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg><span>Log</span></div>
      <div id="sver"></div>
    </div>

    <!-- HOME -->
    <div class="page" id="page_home" style="display:block">
      <div id="hwelcome">Welcome Back, <span id="wname">player</span> <span id="wcaret" onclick="show('account')">&#9662;</span></div>
      <div id="topbar" style="display:none"><span id="qplabel"></span><span id="qp"></span><div id="acctpill"><img id="acctimg" /><span id="acctsmall"></span></div></div>
      <div id="hero">
        <div id="herofade"></div>
        <div id="herogl1"></div><div id="herogl2"></div>
        <button id="herobtn" onclick="play()">LAUNCH</button>
        <div id="herosub"><span id="herotitle">Minecraft</span> <span id="herodesc"></span></div>
        <div id="heroalt" onclick="show('play')">Choose a version</div>
        <div id="hhead" style="display:none"><span id="ptitle"></span><span id="psub"></span><span id="hname"></span><span id="herotag"></span></div>
      </div>
      <div id="qpbar"><span id="qplist"></span></div>
      <div id="hnewshead">Latest News</div>
      <div id="hnews"></div>
      <div id="hsrv"><div id="hsrvh">Servers</div><div id="hsrvlist"></div></div>
      <div id="promo"><div id="promox" onclick="$('promo').style.display='none'">&times;</div>
        <span id="promobadge" class="pill">NEW</span>
        <div id="promotext"><b id="promotitle"></b><span id="promodesc"></span></div>
        <button class="btn small" id="promobtn" onclick="openPromo()">Open</button>
      </div>
    </div>

    <!-- SERVERS -->
    <div class="page" id="page_servers">
      <div id="svhead"><div id="ptitle2">Serv<span>ers</span></div><div class="hint">Pick a server and Minecraft opens straight into it (Minecraft 1.20 and newer).</div></div>
      <div id="svlist"></div>
      <div class="card"><div class="label">Add a server</div>
        <input type="text" id="sv_name" placeholder="Name" style="width:150px" /> <input type="text" id="sv_ip" placeholder="play.example.com" style="width:240px" />
        <button class="btn small" onclick="addServer()">Add</button></div>
    </div>

    <!-- PLAY -->
    <div class="page" id="page_play">
      <div id="phead">
        <div id="ptitle">Versions</div>
        <div id="psub">Pick a version, or launch one of your own</div>
        <div id="pright">
          <div id="updbar" class="pill" style="display:none; margin-right:8px;"><span id="updtext"></span> <button class="btn small" onclick="applyUpdate()">Update now</button></div>
          <button class="btn small" id="navbtn" onclick="checkAccount()">Check again</button>
          <div id="chip">
            <div id="avatar">?</div>
            <div id="acctText">
              <div id="who">No account</div>
              <div id="email"></div>
            </div>
          </div>
        </div>
      </div>

      <div id="vtabs"><span class="vtab on" id="vt_all" onclick="setVTab('all')">All</span><span class="vtab" id="vt_fab" onclick="setVTab('fab')">Mods</span><span class="vtab" id="vt_van" onclick="setVTab('van')">Vanilla</span><input type="text" id="vsearch" placeholder="Search versions" onkeyup="renderCards()" /></div>
      <div id="vgrid"></div>

      <div class="card" id="vpanel">
        <div id="vart"><img id="vskin" style="display:none" onerror="this.style.display='none'" /></div>
        <div id="vbody">
          <div id="vtitle">Minecraft</div>
          <div id="vtags"></div>
          <div id="vdesc"></div>
          <div class="vrow">Account <span id="badge">No account</span></div>
          <div class="vrow">Memory <b id="vram">2 GB</b></div>
          <div id="vsel"><select id="versions" onchange="pickVersion(this.value)"></select></div>
          <div class="meta" id="modwarn" style="color:#ffb86b; margin:8px 0 0 0; min-height:16px; line-height:1.4;"></div>
          <div id="prog" style="display:none; margin-top:8px;">
            <div class="meta" id="progtext" style="margin-bottom:6px;"></div>
            <div id="pbar"><div id="pfill"></div></div>
          </div>
          <button id="playbtn" onclick="play()">LAUNCH GAME</button>
        </div>
      </div>
    </div>

    <!-- MODS -->
    <div class="page" id="page_mods">
      <div class="panel">
        <h2>Mods</h2>
        <p class="sub">Built-in mods and your own. Click <b>+ Add a mod</b> and pick a Fabric .jar. <span id="modCount"></span></p>
        <input type="text" id="modsearch" placeholder="Search mods" onkeyup="filterMods()" />
        <div class="card" style="background:none;border:0;padding:0">
          <div class="list" id="modList"></div>
        </div>
        <div class="toolrow">
          <button class="btn small" onclick="$('modfile').click()">+ Add a mod</button>
          <input type="file" id="modfile" accept=".jar" onchange="addModFile()" style="display:none" />
          <button class="btn small" onclick="openFolder('mods')">Open mods folder</button>
          <button class="btn small" onclick="loadMods()">Refresh</button>
        </div>
      </div>
    </div>

    <!-- SAVES -->
    <div class="page" id="page_saves">
      <div class="panel">
        <h2>Saves</h2>
        <p class="sub">Your worlds, newest first. <span id="saveCount"></span></p>
        <div class="card">
          <div class="list" id="saveList"></div>
        </div>
        <div class="toolrow">
          <button class="btn small" onclick="openFolder('saves')">Open saves folder</button>
          <button class="btn small" onclick="loadSaves()">Refresh</button>
        </div>
      </div>
    </div>

    <!-- ACCOUNT -->
    <div class="page" id="page_account">
      <div class="panel">
        <h2>Account</h2>
        <p class="sub">Sign in with Microsoft to verify you own Minecraft.</p>
        <div class="card">
          <div class="label">Microsoft login</div>
          <button class="btn small" onclick="startLogin()">Sign in with Microsoft</button>
          <button class="btn small" onclick="signOut()">Sign out</button>
          <div id="codebox" style="display:none; margin-top:16px;">
            <div class="hint" style="margin:0 0 6px 0;">Go to <b id="link"></b> and enter this code:</div>
            <div id="code"></div>
          </div>
        </div>
        <p class="sub">Other accounts found on this PC:</p>
        <div class="card">
          <div class="label">Choose account</div>
          <select id="accounts" onchange="pick()"></select>
          <div class="hint">Accounts come from the official Minecraft launcher on this PC. No passwords or tokens are read or shown.</div>
        </div>
      </div>
    </div>

    <!-- SETTINGS -->
    <div class="page" id="page_settings" style="overflow:auto; bottom:30px;">
      <div class="panel" style="position:relative; top:0; left:0; margin:30px auto 40px auto;">
        <h2>Settings</h2>
        <p class="sub">Make Minicraft yours. Changes save automatically.</p>

        <div class="card">
          <div class="label">Performance</div>
          <div class="srow">
            <span class="sname">Memory (RAM)<span class="sdesc">More helps with mods and big worlds. Stay under half of your PC's RAM.</span></span>
            <select id="s_ram" class="ssel" onchange="saveSettings()">
              <option value="2">2 GB</option><option value="3">3 GB</option><option value="4">4 GB</option>
              <option value="6">6 GB</option><option value="8">8 GB</option>
            </select>
          </div>
        </div>

        <div class="card">
          <div class="label">Display</div>
          <div class="srow">
            <span class="sname">Fullscreen<span class="sdesc">Start the game fullscreen</span></span>
            <input type="checkbox" id="s_full" onclick="saveSettings()" />
          </div>
          <div class="srow">
            <span class="sname">Window size<span class="sdesc">Used when fullscreen is off</span></span>
            <select id="s_size" class="ssel" onchange="saveSettings()">
              <option value="default">Default</option><option value="1280x720">1280 x 720</option>
              <option value="1600x900">1600 x 900</option><option value="1920x1080">1920 x 1080</option>
            </select>
          </div>
        </div>

        <div class="card">
          <div class="label">Built-in</div>
          <div class="srow" style="display:none">
            <span class="sname">Use built-in mods<span class="sdesc">Off by default. Turn on to set up Fabric and the mods below (needs Minecraft 1.21 to 1.21.11)</span></span>
            <input type="checkbox" id="s_mods" onclick="saveSettings()" />
          </div>
          <div class="srow">
            <span class="sname">FPS boost<span class="sdesc">Tuned Java memory flags, low-cost video options and built-in performance mods</span></span>
            <input type="checkbox" id="s_fps" onclick="saveSettings()" />
          </div>
          <div id="modopts" style="display:none">
            <div class="srow">
              <span class="sname">HUD+<span class="sdesc">FPS counter, CPS counter, keystrokes, coordinates, armor status</span></span>
              <input type="checkbox" id="s_hud" onclick="saveSettings()" />
            </div>
            <div class="srow">
              <span class="sname">Sodium<span class="sdesc">Big FPS boost and smoother gameplay</span></span>
              <input type="checkbox" id="s_sodium" onclick="saveSettings()" />
            </div>
          </div>
          <div class="hint">Mods download the first time you play. If a mod is not out for your Minecraft version it is skipped, and if Fabric is not available Minecraft starts plain. Your own Fabric mods in the mods folder load too. In game, press Right Shift to open HUD+'s editor, where you switch on and move the FPS and CPS counters.</div>
        </div>

        <div class="card">
          <div class="label">Minecraft menus</div>
          <div class="srow">
            <span class="sname">Minicraft menu theme<span class="sdesc">Dark glass buttons, the Minicraft logo and a blossom background on the title screen and ESC menu. Works on Minecraft 1.21 and newer.</span></span>
            <input type="checkbox" id="s_pack" onclick="saveSettings()" />
          </div>
        </div>

        <div class="card" style="display:none">
          <div class="label">Custom cape</div>
          <div class="srow">
            <span class="sname">Use a custom cape<span class="sdesc">Adds the Client Capes mod. Only you can see your cape, not other players.</span></span>
            <input type="checkbox" id="s_cape" onclick="saveSettings()" />
          </div>
          <div id="capeList" class="capelist"></div>
          <button class="btn small" onclick="$('capefile').click()">+ Add a cape</button>
          <input type="file" id="capefile" accept=".png" onchange="addCapeFile()" style="display:none" />
          <button class="btn small" onclick="openCapes()">Open Capes folder</button>
          <div class="hint">Use a normal Minecraft cape PNG. In game, press Change Cape on the main menu to switch between your capes. Works on Minecraft 1.21 to 1.21.1, 1.21.4 to 1.21.5, 1.21.7 and some 1.20 versions.</div>
        </div>

        <div class="card">
          <div class="label">Maintenance</div>
          <button class="btn small" onclick="clearFast()">Re-check game files</button>
          <button class="btn small" onclick="show('saves')">Saves</button> <button class="btn small" onclick="show('account')">Account</button> <button class="btn small" onclick="show('log')">Log</button>
          <div class="label" style="margin-top:22px">Updates</div>
          <button class="btn small" onclick="checkUpdate(true)">Check for updates</button>
          <div class="hint">Mini Client checks for a new version when it opens and can replace itself in one click.</div>
        </div>
      </div>
    </div>

    <!-- LOG -->
    <div class="page" id="page_log">
      <div class="panel">
        <h2>Log</h2>
        <p class="sub">What the client found. No tokens are shown.</p>
        <textarea id="log" readonly></textarea>
      </div>
    </div>

    <div id="bar">Status: <span id="status">Starting...</span></div>
  </div>

</body>
</html>
